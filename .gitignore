# Dependencies
node_modules/

# Build output
dist/
build/

# Environment — never commit secrets
.env
.env.local
.env.production
.env.*.local

# Logs
logs/
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/settings.json
*.swp
lint-output.txt

# Playwright — browser-verification artefacts.
# Screenshots are evidence for a run, not source; they are regenerated by
# `npx playwright test` and would otherwise add megabytes per run to history.
client/test-results/
client/playwright-report/
client/e2e/screenshots/

# Database dumps. Never committed: a dump is a copy of whatever was in the
# database at the time, and "it was only demo data" is a claim nobody can
# verify from a diff a year later. Keep them locally, out of history.
backups/
*.sql.gz
*.dump
