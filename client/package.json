    "@fontsource-variable/noto-sans-tamil": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "axios": "^1.18.1",
    "framer-motion": "^11.3.0",
    "lucide-react": "^0.446.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
