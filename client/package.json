{
  "name": "stroke-ai-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
