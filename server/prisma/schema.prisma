// =============================================================================
// Stroke AI — Database Schema
// Designed for a commercial stroke-care platform (patient / doctor / admin).
//
// Design principles:
//  - User table = authentication + identity ONLY. No medical data.
//  - PatientProfile = demographics only. No clinical data.
//  - AuditLog is INSERT-ONLY and immutable (HIPAA/GDPR compliance).
//  - All FKs are explicitly indexed.
//  - Soft delete via deletedAt on User and PatientProfile.
//  - UUID primary keys on all tables.
//  - DB column names: snake_case via @map / @@map.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (whatever glibc/macOS host you run on).
  // "linux-musl-openssl-3.0.x" is required for the Docker image — it's
  // built on node:20-alpine, which uses musl libc, not glibc. Without this,
  // `prisma generate` run on a non-Alpine host would produce a client
  // missing the engine binary the container actually needs at runtime.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

/// The fixed set of roles in the platform.
/// New roles require a migration — intentional. Roles are a schema concern.
enum RoleName {
  Admin
  Patient
  Doctor
  HealthcareWorker
  LabTechnician

  @@map("role_name")
}

/// Biological sex / gender identity for patient demographics.
/// PreferNotToDisclose satisfies privacy requirements.
enum Gender {
  Male
  Female
  Other
  PreferNotToDisclose

  @@map("gender")
}

/// Blood group classification using ABO + Rh system.
enum BloodGroup {
  A_Positive
  A_Negative
  B_Positive
  B_Negative
  AB_Positive
  AB_Negative
  O_Positive
  O_Negative
  Unknown

  @@map("blood_group")
}

/// Marital status for patient demographics.
enum MaritalStatus {
  Single
  Married
  Divorced
  Widowed
  Separated
  PreferNotToDisclose

  @@map("marital_status")
}

/// Smoking status for lifestyle assessment.
enum SmokingStatus {
  Never
  Former
  Current
  Occasional

  @@map("smoking_status")
}

/// Alcohol consumption status.
enum AlcoholStatus {
  Never
  Occasional
  Moderate
  Heavy

  @@map("alcohol_status")
}

/// Tobacco use status (includes smokeless tobacco).
enum TobaccoStatus {
  Never
  Former
  Current

  @@map("tobacco_status")
}

/// Physical activity level for lifestyle assessment.
enum PhysicalActivity {
  Sedentary
  Light
  Moderate
  Active
  VeryActive

  @@map("physical_activity")
}

/// Severity classification for audit events.
/// Used for alerting thresholds in future SIEM integration.
enum AuditSeverity {
  Info
  Warning
  Critical

  @@map("audit_severity")
}

/// All security-relevant actions that must be audited.
/// Extend this enum as new modules are added — never remove values.
enum AuditAction {
  UserRegistered
  UserLoginSuccess
  UserLoginFailed
  UserLogout
  PasswordChanged
  AccountLocked
  AccountUnlocked
  EmailVerified
  UnauthorizedAccess
  ProfileUpdated
  ProfilePhotoUpdated
  RoleChanged
  AccountDeleted
  // ── Session lifecycle (refresh-token rotation) ──────────────────────────
  TokenRefreshed
  TokenReuseDetected
  SessionRevoked
  // ── Patient identity & encounters (Phase 6) ─────────────────────────────
  PatientRegistered
  PatientSearched
  PatientRecordViewed
  PatientDuplicateDetected
  PatientDuplicateAcknowledged
  PatientAccountLinked
  EncounterCreated
  EncounterClosed
  AssessmentCreated
  AssessmentUpdated
  AiMessageSent
  AiResponseGenerated
  AiEmergencyInterlockTriggered
  AiOutputBlocked
  AiBudgetExceeded
  AiPolicyBlocked
  AiProviderError
  AiConversationDeleted

  @@map("audit_action")
}

// =============================================================================
// ROLE
//
// Separated from User to allow RBAC expansion without touching the users table.
// Future: add a `level` (Int) field for role hierarchy if privilege escalation
// checks are needed.
// =============================================================================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // ── Relations ───────────────────────────────────────────────────────────
  users           User[]
  rolePermissions RolePermission[]

  // ── Index: isActive for filtering inactive roles ─────────────────────────
  @@index([isActive])
  @@map("roles")
}

// =============================================================================
// PERMISSION
//
// Foundation scaffold. Currently unpopulated.
// Module-level permissions are added here as new domains are built.
// Example records:
//   { name: "patient:read",   resource: "patient", action: "read"   }
//   { name: "lab:create",     resource: "lab",     action: "create" }
//
// resource + action combination is the functional unique key.
// =============================================================================

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique              // e.g. "patient:read"
  description String?
  resource    String                        // e.g. "patient", "lab_report"
  action      String                        // e.g. "create", "read", "update", "delete"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // ── Relations ───────────────────────────────────────────────────────────
  rolePermissions RolePermission[]

  // ── Composite index: most queries filter by resource + action ────────────
  @@index([resource, action])
  @@map("permissions")
}

// =============================================================================
// ROLE_PERMISSION  (Join Table — Many-to-Many: Role ↔ Permission)
//
// Composite PK prevents duplicate role-permission assignments.
// Cascade delete on both sides: removing a role or permission
// automatically cleans up the assignment. No orphaned rows.
// =============================================================================

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  // ── Relations ───────────────────────────────────────────────────────────
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =============================================================================
// USER
//
// Authentication and identity ONLY.
// No name. No phone number. No date of birth. No medical information.
// Profile data lives in PatientProfile / DoctorProfile (future) / etc.
//
// Security fields explained:
//  failedLoginAttempts — incremented on each failed login; reset on success.
//  lockedUntil         — if set and in the future, login is rejected.
//  lastLoginAt         — audit trail; detect stale/unused accounts.
//  passwordChangedAt   — detect accounts that never changed default passwords.
//  verificationToken   — one-time token for email verification flow.
//  verificationExpires — token expiry; must be checked before accepting token.
//  deletedAt           — soft delete; row is retained, login is rejected.
// =============================================================================

model User {
  id    String   @id @default(uuid()) @db.Uuid
  email String   @unique
  passwordHash String @map("password_hash")

  // ── Role FK ──────────────────────────────────────────────────────────────
  roleId String @map("role_id") @db.Uuid

  // ── Account Status ────────────────────────────────────────────────────────
  isVerified Boolean @default(false) @map("is_verified")
  isActive   Boolean @default(true)  @map("is_active")

  // ── Security Fields ───────────────────────────────────────────────────────
  failedLoginAttempts Int       @default(0)  @map("failed_login_attempts")
  lockedUntil         DateTime?              @map("locked_until")
  lastLoginAt         DateTime?              @map("last_login_at")
  passwordChangedAt   DateTime?              @map("password_changed_at")

  // ── Email Verification ────────────────────────────────────────────────────
  // verificationToken is UNIQUE: prevents token collision across users.
  // It is nullable: NULL when the account is already verified.
  verificationToken   String?   @unique @map("verification_token")
  verificationExpires DateTime?           @map("verification_expires")

  // ── Soft Delete ───────────────────────────────────────────────────────────
  deletedAt DateTime? @map("deleted_at")

  // ── Timestamps ────────────────────────────────────────────────────────────
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  // ── Relations ─────────────────────────────────────────────────────────────
  role               Role                 @relation(fields: [roleId], references: [id])
  patientProfile     PatientProfile?
  doctorProfile      DoctorProfile?
  staffProfile       StaffProfile?
  auditLogs          AuditLog[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens      RefreshToken[]
  notifications      Notification[]
  aiConversations    AiConversation[]

  // ── Indexes ───────────────────────────────────────────────────────────────
  // email: @unique creates the lookup index implicitly — not duplicated here.
  //
  // [roleId]: FK columns must be indexed; Prisma does NOT auto-index FKs.
  // PostgreSQL will use this for JOIN queries against the roles table.
  //
  // [isActive, deletedAt]: compound index for the most common query pattern:
  //   WHERE is_active = true AND deleted_at IS NULL
  //
  // [createdAt]: range queries for admin dashboards and reporting.
  @@index([roleId])
  @@index([isActive, deletedAt])
  @@index([createdAt])
  @@map("users")
}

// =============================================================================
// PATIENT PROFILE
//
// Comprehensive patient identity, demographics, contact, lifestyle, and
// medical summary information. One-to-one with User.
//
// This table serves as the central source of truth for patient identity.
// Clinical data (diagnoses, lab results, NGS) lives in future domain tables.
//
// onDelete: Restrict — a User with a PatientProfile cannot be hard-deleted.
// This is a DB-level guard. The application must soft-delete via deletedAt.
// This prevents accidental permanent loss of patient records.
//
// profilePhoto: stores only the filename/path — binary data NEVER goes in DB.
// =============================================================================

model PatientProfile {
  id     String  @id @default(uuid()) @db.Uuid
  // Nullable as of Phase 6: a staff/field-registered patient (e.g. an
  // unconscious ambulance arrival) has no email/password and therefore no
  // User row yet. `link-account` attaches one later. Postgres unique indexes
  // permit any number of NULLs, so multiple login-less patients coexist
  // without conflict. All pre-Phase-6 rows keep their non-null userId.
  userId String? @unique @map("user_id") @db.Uuid

  // ── Platform identity (Phase 6) ────────────────────────────────────────────
  // Public-facing, stable, non-enumerable identifier. Never the internal
  // UUID — see server/src/utils/shriId.ts for the generation scheme.
  shriPatientId String @unique @map("shri_patient_id")

  // Deterministic HMAC-SHA256 blind index of the normalized mobile number
  // (see server/src/utils/phone.ts + hmacBlindIndex in encryption.ts).
  // Deliberately NOT @unique: verified against live data, a single mobile
  // handset is legitimately shared by more than one family member/patient.
  // A strong signal for duplicate detection, never an identity guarantee.
  phoneNumberHash String? @map("phone_number_hash")

  /// True only for fabricated demonstration records. The AI assistant refuses
  /// to send anything else to a provider when AI_DATA_POLICY=synthetic-only,
  /// which is the default. Fails closed: absent or false means "real".
  isSyntheticData Boolean @default(false) @map("is_synthetic_data")

  registrationSource RegistrationSource @default(SelfRegistered) @map("registration_source")
  // Set only when registrationSource is Staff/FieldRegistered. The User who
  // performed the registration — used by the HealthcareWorker care-relationship
  // grant (see careRelationship.service.ts) since a field worker has no
  // CareTeamMember row.
  registeredByUserId String? @map("registered_by_user_id") @db.Uuid
  identityStatus     IdentityStatus @default(Unverified) @map("identity_status")

  // ── Basic Information ─────────────────────────────────────────────────────
  firstName     String        @map("first_name")
  middleName    String?       @map("middle_name")
  lastName      String        @map("last_name")
  // Nullable as of Phase 6: an unconscious/unidentified patient may have no
  // known DOB. dobIsEstimated distinguishes a real recorded value from a
  // clinician's best guess — never silently treated the same as a confirmed
  // date (age-based dosing depends on this distinction).
  dateOfBirth    DateTime?      @map("date_of_birth") @db.Date
  dobIsEstimated Boolean        @default(false) @map("dob_is_estimated")
  gender        Gender?
  bloodGroup    BloodGroup?   @map("blood_group")
  maritalStatus MaritalStatus? @map("marital_status")

  // ── Profile Photo ─────────────────────────────────────────────────────────
  // Stores only the relative filename — e.g. "uuid.jpg"
  // Full URL is constructed at the service layer.
  // Binary data NEVER stored in PostgreSQL.
  profilePhoto      String?       @map("profile_photo")
  photoMetadata     ProfilePhoto?

  // ── Identification ────────────────────────────────────────────────────────
  // abhaId is stored ENCRYPTED (AES-256-GCM, random IV per value) — see
  // server/src/utils/encryption.ts. Because a random IV means the same
  // plaintext never re-encrypts to the same ciphertext, uniqueness can't be
  // enforced on this column directly. abhaIdHash is a deterministic
  // HMAC-SHA256 blind index of the plaintext, carrying the @unique
  // constraint instead — the encrypted value is never used for lookups.
  abhaId        String? @map("abha_id")
  abhaIdHash    String? @unique @map("abha_id_hash")
  passportNumber String? @map("passport_number")
  // Only the last 4 digits are ever accepted or stored — the full 12-digit
  // Aadhaar number is never persisted, so there is no "full identifier" to
  // secure/migrate later. Displayed to the user as e.g. "XXXX-XXXX-1234".
  // Stored encrypted — no longer a fixed-width column (ciphertext is longer
  // than 4 chars).
  aadhaarLast4  String? @map("aadhaar_last4")

  // ── Contact ───────────────────────────────────────────────────────────────
  // phoneNumber/alternatePhone/address* are stored ENCRYPTED (see abhaId
  // comment above for the encryption scheme). country is left plaintext —
  // low sensitivity, used as a display default.
  phoneNumber     String? @map("phone_number")
  alternatePhone  String? @map("alternate_phone")
  addressLine1    String? @map("address_line1")
  addressLine2    String? @map("address_line2")
  village         String?
  city            String?
  district        String?
  state           String?
  country         String? @default("India")
  postalCode      String? @map("postal_code")

  // ── Emergency Contact ─────────────────────────────────────────────────────
  // Stored ENCRYPTED.
  emergencyContactName     String? @map("emergency_contact_name")
  emergencyContactPhone    String? @map("emergency_contact_phone")
  emergencyContactRelation String? @map("emergency_contact_relation")

  // ── Lifestyle ─────────────────────────────────────────────────────────────
  smokingStatus    SmokingStatus?  @map("smoking_status")
  alcoholStatus    AlcoholStatus?  @map("alcohol_status")
  tobaccoStatus    TobaccoStatus?  @map("tobacco_status")
  physicalActivity PhysicalActivity? @map("physical_activity")
  occupation       String?

  // ── Medical Summary ───────────────────────────────────────────────────────
  // Stored as plain text / comma-separated lists, ENCRYPTED.
  // Future: normalize to separate tables per domain requirement.
  knownAllergies    String?   @map("known_allergies")
  currentMedications String? @map("current_medications")
  existingDiseases  String?  @map("existing_diseases")
  familyHistory     String?  @map("family_history")
  previousSurgeries String?  @map("previous_surgeries")

  // ── Preferences ───────────────────────────────────────────────────────────
  // Notification/privacy/accessibility/language settings from the Settings
  // page. Not sensitive PII — stored as plaintext JSON, not encrypted.
  preferences Json?

  // ── Soft Delete ───────────────────────────────────────────────────────────
  deletedAt DateTime? @map("deleted_at")

  // ── Timestamps ────────────────────────────────────────────────────────────
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  // ── Relations ─────────────────────────────────────────────────────────────
  // Nullable relation to match nullable userId — a login-less patient has no
  // linked User row until link-account is used.
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  careTeam     CareTeamMember[]
  appointments Appointment[]
  encounters   Encounter[]

  // ── Indexes ───────────────────────────────────────────────────────────────
  // [lastName, firstName]: name search — clinical staff search patients by name.
  // [abhaIdHash]: @unique blind-index look-up — abhaId itself is encrypted
  // and can't be looked up or constrained directly (see comment above).
  // [phoneNumberHash]: NOT unique — see field comment above.
  // [dateOfBirth]: supports the name+DOB duplicate-matching signal.
  // [registrationSource, createdAt]: lets ops queries filter field/staff
  // registrations without a full table scan.
  // userId / shriPatientId: @unique creates the index implicitly — not duplicated.
  @@index([lastName, firstName])
  @@index([phoneNumberHash])
  @@index([dateOfBirth])
  @@index([registrationSource, createdAt])
  @@map("patient_profiles")
}

enum RegistrationSource {
  /// The existing self-service flow — POST /auth/register. Default value:
  /// correct for every row that existed before Phase 6.
  SelfRegistered
  /// Front-desk / clinic staff registered the patient in person.
  StaffRegistered
  /// Ambulance, health camp, or other low-connectivity field registration.
  FieldRegistered
  /// Reserved for a future bulk/HMIS import path. Not implemented.
  Imported

  @@map("registration_source")
}

enum IdentityStatus {
  /// Name/DOB given verbally, nothing independently checked.
  Unverified
  /// Patient could not identify themselves (e.g. unconscious); a placeholder
  /// name was recorded. Never used for anything beyond a display flag.
  Provisional
  /// ABHA or another document has been checked against this record.
  Verified
  /// This record lost a duplicate-merge decision. No code path sets this yet
  /// — merging is a deliberately unbuilt, destructive operation (see
  /// patient.identity.service.ts) — but the state has a home in the schema
  /// for when a real merge workflow is authorized.
  MergedAway

  @@map("identity_status")
}

// =============================================================================
// AUDIT LOG
//
// Immutable append-only table. INSERT only. No UPDATE. No DELETE. Ever.
// Retained indefinitely per HIPAA Security Rule §164.312(b) and GDPR Article 30.
//
// userId is nullable because:
//  1. System-initiated events have no user context.
//  2. onDelete: SetNull — if a user is deleted, their audit history is
//     preserved with userId = NULL. The log must never be destroyed.
//
// No updatedAt field — adding one would be architecturally incorrect for
// an immutable audit trail. Prisma's @updatedAt would allow mutation.
//
// metadata (Json/jsonb): flexible payload for action-specific context.
// Example: { "ip": "1.2.3.4", "reason": "max_attempts_exceeded" }
// =============================================================================

model AuditLog {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String?       @map("user_id") @db.Uuid
  action     AuditAction
  resource   String?                            // e.g. "user", "patient_profile"
  resourceId String?       @map("resource_id") // UUID of the affected row
  severity   AuditSeverity @default(Info)
  ipAddress  String?       @map("ip_address")
  userAgent  String?       @map("user_agent")
  metadata   Json?

  // No updatedAt — this field's absence is intentional and enforced.
  createdAt DateTime @default(now()) @map("created_at")

  // ── Relations ─────────────────────────────────────────────────────────────
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // ── Indexes ───────────────────────────────────────────────────────────────
  // [userId]: look up all events for a specific user (account activity view)
  // [action]: filter by event type (find all failed logins)
  // [severity]: alert dashboards filter on Critical events.
  // [createdAt]: time-range queries — the primary access pattern for audit logs.
  // [userId, action, createdAt]: the most common security query:
  //   "Show me all failed login attempts for user X in the last 30 days"
  //   This compound index satisfies that query without a table scan.
  @@index([userId])
  @@index([action])
  @@index([severity])
  @@index([createdAt])
  @@index([userId, action, createdAt])
  @@map("audit_logs")
}

// =============================================================================
// PROFILE PHOTO METADATA
//
// Metadata for the patient's profile photo upload.
// One-to-one with PatientProfile.
// =============================================================================
model ProfilePhoto {
  id               String         @id @default(uuid()) @db.Uuid
  patientProfileId String         @unique @map("patient_profile_id") @db.Uuid
  filename         String
  path             String
  mimeType         String         @map("mime_type")
  uploadedAt       DateTime       @default(now()) @map("uploaded_at")

  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@map("profile_photos")
}

// =============================================================================
// PASSWORD RESET TOKEN
//
// Dedicated single-use password reset token store.
// Raw tokens are NEVER stored — only SHA-256 token hashes are persisted.
// Expired or used tokens are rejected.
// =============================================================================
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// =============================================================================
// REFRESH TOKEN
//
// Enables short-lived access tokens (15 min) without logging the patient out
// every 15 minutes — the single biggest usability defect found in the Phase 1
// audit.
//
// Security model mirrors PasswordResetToken, with rotation added:
//  - Raw tokens are NEVER stored. Only a SHA-256 hash is persisted.
//  - Single use: refreshing consumes the token (revokedAt set) and issues a
//    new one. `replacedBy` chains the rotation so a whole family is traceable.
//  - Reuse detection: presenting an already-revoked token means the token was
//    stolen (the legitimate client already rotated it). The correct response is
//    to revoke the ENTIRE family, forcing re-authentication. `familyId` groups
//    every token descended from one login for exactly this purpose.
//  - deviceLabel/ipAddress/userAgent let a patient see and revoke their own
//    sessions later without another schema change.
// =============================================================================
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid

  tokenHash String    @unique @map("token_hash")

  /// All tokens rotated from a single login share this id.
  familyId  String    @map("family_id") @db.Uuid

  /// Set when this token is rotated away or explicitly revoked. Non-null = unusable.
  revokedAt DateTime? @map("revoked_at")
  /// Hash of the token that replaced this one — audit trail for rotation.
  replacedBy String?  @map("replaced_by")

  expiresAt DateTime  @map("expires_at")

  // ── Session context (for a future "your devices" screen) ─────────────────
  deviceLabel String? @map("device_label")
  ipAddress   String? @map("ip_address")
  userAgent   String? @map("user_agent")

  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// =============================================================================
// DOCTOR PROFILE
//
// The Doctor portal is NOT built in Phase 2 — but the identity it will need is
// modelled now so adding it later is additive rather than a restructure.
//
// registrationNumber is the state medical council registration; hprId is the
// ABDM Healthcare Professional Registry id. Both are unique when present, and
// both are the fields a patient-facing "verified doctor" badge would check.
// =============================================================================
model DoctorProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  gender    Gender?

  /// State medical council registration number.
  registrationNumber String? @unique @map("registration_number")
  /// ABDM Healthcare Professional Registry id.
  hprId              String? @unique @map("hpr_id")

  specialty      String?
  qualifications String?
  /// Free text until a Hospital/Facility model is justified by real requirements.
  hospitalName   String? @map("hospital_name")
  yearsExperience Int?   @map("years_experience")

  /// Set by an administrator once credentials are checked. Never self-service.
  isVerified Boolean   @default(false) @map("is_verified")
  verifiedAt DateTime? @map("verified_at")

  phoneNumber String? @map("phone_number")
  profilePhoto String? @map("profile_photo")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  careTeam CareTeamMember[]
  appointments Appointment[]

  @@index([lastName, firstName])
  @@index([specialty])
  @@map("doctor_profiles")
}

// =============================================================================
// STAFF PROFILE
//
// Covers Admin, HealthcareWorker and LabTechnician — roles that need an
// identity and a department but not a clinician's credentials. One table rather
// than three near-identical ones; the role still lives on User.roleId, so this
// does not duplicate role logic.
// =============================================================================
model StaffProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  firstName String @map("first_name")
  lastName  String @map("last_name")

  /// Free-text job title, e.g. "Stroke Care Coordinator".
  jobTitle   String? @map("job_title")
  department String?
  employeeId String? @unique @map("employee_id")

  phoneNumber String? @map("phone_number")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([lastName, firstName])
  @@map("staff_profiles")
}

// =============================================================================
// CARE TEAM MEMBER  (Patient ↔ Doctor assignment)
//
// The keystone of the three-role architecture. Every doctor-facing endpoint
// answers "is this patient yours?" by querying this table — which is exactly
// why profile.routes.ts currently refuses to expose GET /profile/:id: until
// now there was no relationship to authorise against.
//
// Historical rows are preserved via activeTo rather than deletion, so "who was
// on this patient's care team in March?" stays answerable.
// =============================================================================
model CareTeamMember {
  id        String @id @default(uuid()) @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  doctorId  String @map("doctor_id")  @db.Uuid

  /// Role on THIS patient's care team, e.g. "Neurologist", "Physiotherapist".
  /// Distinct from the platform RoleName — a doctor's account role never changes.
  careRole  String  @map("care_role")
  isPrimary Boolean @default(false) @map("is_primary")

  activeFrom DateTime  @default(now()) @map("active_from")
  activeTo   DateTime? @map("active_to")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  DoctorProfile  @relation(fields: [doctorId],  references: [id], onDelete: Restrict)

  /// A doctor holds one active assignment per patient. Re-assignment after an
  /// activeTo is intentionally allowed — hence the composite includes careRole.
  @@unique([patientId, doctorId, careRole])
  @@index([patientId])
  @@index([doctorId])
  @@index([patientId, activeTo])
  @@map("care_team_members")
}

// =============================================================================
// APPOINTMENT
//
// Replaces the mock booking flow, which confirmed appointments no doctor ever
// received (Phase 1 §D-C3).
//
// scheduledAt is stored as an absolute UTC instant; the client renders it in
// the patient's timezone. Never store wall-clock time without a zone.
// =============================================================================
model Appointment {
  id        String @id @default(uuid()) @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  doctorId  String? @map("doctor_id") @db.Uuid

  scheduledAt  DateTime @map("scheduled_at")
  durationMins Int      @default(30) @map("duration_mins")

  mode   AppointmentMode   @default(InPerson)
  status AppointmentStatus @default(Requested)

  /// Patient's own words for why they are attending. Encrypted at rest.
  reason String?
  /// Clinician-authored notes. Encrypted at rest.
  notes  String?

  locationName String? @map("location_name")

  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by") @db.Uuid
  cancelReason String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  DoctorProfile? @relation(fields: [doctorId],  references: [id], onDelete: SetNull)

  /// Reverse side of Encounter.appointmentId. At most one encounter links to
  /// a given appointment (enforced by @unique on that field).
  encounter Encounter?

  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledAt])
  @@index([patientId, status, scheduledAt])
  @@map("appointments")
}

enum AppointmentMode {
  InPerson
  Video
  Phone

  @@map("appointment_mode")
}

enum AppointmentStatus {
  Requested
  Confirmed
  Completed
  Cancelled
  NoShow

  @@map("appointment_status")
}

// =============================================================================
// NOTIFICATION
//
// Replaces the hardcoded notification array in Topbar.jsx.
// Deliberately minimal: no delivery-channel matrix, no templating engine, no
// scheduling. Those are speculative until real notification triggers exist.
// =============================================================================
model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  type  NotificationType @default(General)
  title String
  body  String?

  /// In-app route this notification points at, e.g. "/app/appointments".
  actionUrl String? @map("action_url")

  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Covers the only two real queries: the unread badge count, and the
  /// reverse-chronological notification list.
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// =============================================================================
// AI INSIGHTS (Phase 7)
//
// Conversation history for the patient-facing assistant. The model is NOT
// wired up yet — these tables exist so the transcript is durable from day one,
// because a chat that forgets itself on refresh is not something a patient can
// rely on, and because retro-fitting persistence under a live assistant is far
// worse than having it waiting.
//
// Message bodies are ENCRYPTED at rest. A patient asking "should I be worried
// about this weakness in my arm" is writing health information as surely as
// any field on PatientProfile, and it is stored under the same rules.
//
// Scoped to User, not PatientProfile: a clinician portal will want the same
// assistant, and nothing here is patient-record-specific.
// =============================================================================
model AiConversation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Derived from the first question asked, and renameable. Encrypted for the
  /// same reason the messages are — it is usually a health question verbatim.
  title String

  /// Soft-delete. A transcript the patient removed should stop appearing
  /// without destroying an audited clinical conversation outright.
  deletedAt DateTime? @map("deleted_at")

  /// Rolling summary of turns older than the working window. ENCRYPTED, same
  /// rule as the messages it summarises. Written AFTER a reply is returned so
  /// the summariser is never on the patient's critical path.
  summary String? 
  summaryThroughMessageId String? @map("summary_through_message_id") @db.Uuid
  summaryTokenCount       Int?    @map("summary_token_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  /// The only list query: this user's conversations, most recently used first.
  @@index([userId, deletedAt, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid

  role    AiMessageRole
  /// Encrypted at rest — see the note on AiConversation.
  content String

  /// Kept for back-compat with rows written before `kind` existed. New code
  /// reads `kind`; this stays true only for legacy placeholder rows.
  isPlaceholder Boolean @default(false) @map("is_placeholder")

  /// What actually produced this turn. `isPlaceholder` was already doing this
  /// job badly with two states, and there are now five. The transcript must
  /// never imply the assistant said something clinical that it did not, so
  /// the provenance of every turn is explicit and rendered differently.
  kind AiMessageKind @default(Model)

  /// Which safety ruleset evaluated this turn — so a behaviour change is
  /// attributable after the fact.
  safetyRuleVersion String? @map("safety_rule_version")

  createdAt DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum AiMessageRole {
  User
  Assistant

  @@map("ai_message_role")
}

enum AiMessageKind {
  /// Generated by the model and passed every output check.
  Model
  /// Written before any model was connected.
  Placeholder
  /// The deterministic emergency interlock fired; the model was never called.
  SafetyInterlock
  /// The model answered but an output check rejected it.
  SafetyBlocked
  /// Refused before calling the model because a budget was exhausted.
  BudgetDeferred
  /// Refused because this deployment may not send real patient data upstream.
  PolicyBlocked

  @@map("ai_message_kind")
}

/// Per-day AI usage. In Postgres rather than memory because a restart at 6pm
/// must not hand every patient a fresh allowance and drain the daily quota.
/// The row with a null userId is the shared/global pool.
model AiUsageDaily {
  id     String   @id @default(uuid()) @db.Uuid
  userId String?  @map("user_id") @db.Uuid
  day    DateTime @db.Date

  requests         Int @default(0)
  promptTokens     Int @default(0) @map("prompt_tokens")
  completionTokens Int @default(0) @map("completion_tokens")
  blockedCount     Int @default(0) @map("blocked_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([userId, day])
  @@map("ai_usage_daily")
}

enum NotificationType {
  General
  Appointment
  Report
  Medication
  CareTeam

  @@map("notification_type")
}

// =============================================================================
// ENCOUNTER (Phase 6)
//
// A Patient may have many Encounters — one per visit/episode/contact with the
// healthcare system. This is deliberately GENERIC: nothing stroke-specific
// lives here. Stroke intake hangs off an Encounter via StrokeAssessment
// (below), the same way a future OncologyAssessment or CardiologyAssessment
// would — each a pure additive table with `encounterId @unique`, requiring
// zero change to this model or to PatientProfile.
//
// onDelete: Restrict on `patient` (not Cascade, unlike Appointment/CareTeam):
// an encounter is itself a clinical record and must never be silently
// destroyed as a side effect of another operation.
// =============================================================================
model Encounter {
  id        String @id @default(uuid()) @db.Uuid
  patientId String @map("patient_id") @db.Uuid

  /// Public, immutable, server-generated. Same Crockford-Base32 scheme as
  /// shriPatientId (see server/src/utils/shriId.ts) — never updated after
  /// creation; no repository method exposes a way to change it.
  visitId String @unique @map("visit_id")

  type   EncounterType
  status EncounterStatus @default(InProgress)

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  /// Free text naming a real place ("Coimbatore field camp, block 3").
  /// Encrypted at rest — see server/src/encounter/encounter.repository.ts.
  locationName String? @map("location_name")

  /// Who opened it. Nullable: a future offline/device-originated path may
  /// have no authenticated user at capture time.
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  /// Optional link to a booked Appointment. SetNull, not Cascade/Restrict —
  /// losing the appointment (e.g. it is later deleted) must never destroy
  /// the clinical encounter record.
  appointmentId String? @unique @map("appointment_id") @db.Uuid

  /// Clinician free text — why the patient presented. Encrypted at rest.
  chiefComplaint String? @map("chief_complaint")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  strokeAssessment StrokeAssessment?

  @@index([patientId, startedAt])
  @@index([status])
  @@index([type, startedAt])
  @@index([createdByUserId, startedAt])
  @@map("encounters")
}

enum EncounterType {
  ClinicVisit
  AmbulanceIntake
  Emergency
  Telehealth
  FollowUp
  Screening
  FieldRegistration

  @@map("encounter_type")
}

enum EncounterStatus {
  InProgress
  Completed
  Cancelled

  @@map("encounter_status")
}

// =============================================================================
// STROKE DOMAIN MODULE (Phase 6)
//
// This is a DOMAIN module, not part of the generic platform. It hangs off
// Encounter via a one-to-one relation and touches nothing on Patient or
// Encounter itself. A future OncologyAssessment/CardiologyAssessment is a
// pure additive CREATE TABLE following this exact shape — no migration to
// this file, no migration to Encounter or PatientProfile.
//
// A polymorphic single "Assessment" table with a domain discriminator and a
// JSON payload was considered and rejected: it would make future domains
// "free" at the cost of destroying type safety on values where a wrong entry
// is a patient-harm event (a JSON key can't be validated by an index, and a
// mistyped LKW timestamp buried in a blob is much easier to miss than one in
// a typed, indexed column).
// =============================================================================
model StrokeAssessment {
  id          String @id @default(uuid()) @db.Uuid
  encounterId String @unique @map("encounter_id") @db.Uuid

  // ── Last Known Well ────────────────────────────────────────────────────────
  // The single most consequential value in acute stroke care — it gates
  // thrombolysis eligibility. See StrokeLkwRevision below: every change to
  // these three fields must be independently, transactionally recorded.
  lkwAt        DateTime?     @map("lkw_at")
  lkwCertainty LkwCertainty  @default(Unknown) @map("lkw_certainty")
  lkwSource    LkwSource?    @map("lkw_source")
  /// Free text context ("wife last saw him normal at dinner"). Encrypted.
  lkwNote      String?       @map("lkw_note")

  // ── Symptom flags ──────────────────────────────────────────────────────────
  // A checklist of REPORTED symptoms, not a diagnosis. The service layer
  // must never render or log any of this as "patient has stroke" — only as
  // "potential stroke symptoms identified" (see encounter.service.ts).
  facialWeakness     Boolean @default(false) @map("facial_weakness")
  armWeakness        Boolean @default(false) @map("arm_weakness")
  legWeakness        Boolean @default(false) @map("leg_weakness")
  speechDifficulty   Boolean @default(false) @map("speech_difficulty")
  suddenConfusion    Boolean @default(false) @map("sudden_confusion")
  visionProblem      Boolean @default(false) @map("vision_problem")
  severeHeadache     Boolean @default(false) @map("severe_headache")
  balanceProblem     Boolean @default(false) @map("balance_problem")
  lossOfConsciousness Boolean @default(false) @map("loss_of_consciousness")
  /// Free text for a symptom not covered above. Encrypted.
  otherSymptomNote   String? @map("other_symptom_note")

  /// True only when at least one symptom flag above is set AND the encounter
  /// type indicates urgency. This is a WORKFLOW SIGNAL — routes the patient
  /// to the right queue faster — never presented as a diagnosis.
  urgentFlag Boolean @default(false) @map("urgent_flag")

  onAnticoagulants Boolean? @map("on_anticoagulants")

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  encounter  Encounter           @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  lkwHistory StrokeLkwRevision[]

  @@index([lkwAt])
  @@index([urgentFlag])
  @@map("stroke_assessments")
}

enum LkwCertainty {
  /// Witnessed; the clock time is known and trusted.
  Exact
  /// A window is known ("around 8pm") but not a precise time.
  Approximate
  /// Wake-up stroke — LKW is the time the patient was last seen normal
  /// before sleep, not the time symptoms were noticed.
  WakeUp
  Unknown

  @@map("lkw_certainty")
}

enum LkwSource {
  Patient
  Family
  Bystander
  EmergencyServices
  ClinicalRecord

  @@map("lkw_source")
}

/// Append-only revision log for Last Known Well. Written in the SAME
/// transaction as the StrokeAssessment update that changes lkwAt/lkwCertainty
/// — never relying solely on the fire-and-forget AuditLog, whose own service
/// explicitly swallows write failures (acceptable for "someone viewed a
/// page", not acceptable for the value that gates thrombolysis). A generic
/// AuditLog row is additionally emitted for the security trail — this is the
/// one place that duplication is deliberate.
model StrokeLkwRevision {
  id           String @id @default(uuid()) @db.Uuid
  assessmentId String @map("assessment_id") @db.Uuid

  previousLkwAt     DateTime?     @map("previous_lkw_at")
  previousCertainty LkwCertainty? @map("previous_certainty")
  newLkwAt          DateTime?     @map("new_lkw_at")
  newCertainty      LkwCertainty  @map("new_certainty")
  newSource         LkwSource?    @map("new_source")

  /// Why it changed. Required — a change to this value with no stated
  /// reason is exactly the gap a later incident review would need filled.
  /// Encrypted at rest.
  reason          String
  changedByUserId String?  @map("changed_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  assessment StrokeAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, createdAt])
  @@map("stroke_lkw_revisions")
}
