// =============================================================================
// Stroke AI — Database Schema
// Designed for a commercial stroke-care platform (patient / doctor / admin).
//
// Design principles:
//  - User table = authentication + identity ONLY. No medical data.
//  - PatientProfile = demographics only. No clinical data.
//  - AuditLog is INSERT-ONLY and immutable (HIPAA/GDPR compliance).
//  - All FKs are explicitly indexed.
//  - Soft delete via deletedAt on User and PatientProfile.
//  - UUID primary keys on all tables.
//  - DB column names: snake_case via @map / @@map.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (whatever glibc/macOS host you run on).
  // "debian-openssl-3.0.x" is required for the Docker image. The image was
  // node:20-alpine (musl) through Phase 7; Phase 8 switched it to
  // node:20-bookworm-slim (Debian, glibc) because onnxruntime-node — used by
  // the AI Insights embedding pipeline — ships no musl-compatible binary. See
  // the Dockerfile header for the full reasoning. Without the matching
  // target here, `prisma generate` run on a non-Debian host would produce a
  // client missing the engine binary the container actually needs.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

/// The fixed set of roles in the platform.
/// New roles require a migration — intentional. Roles are a schema concern.
enum RoleName {
  Admin
  Patient
  Doctor
  /// Authors clinical entries but may not attest them alone — a Resident's
  /// note enters CosignPending and needs a consultant's counter-signature
  /// (CMP-NABH-03). ⚠️ The distinction is enforced by CAPABILITY, never by
  /// this name: Resident simply lacks `note:sign:own` and holds
  /// `note:write:assigned`. See config/permissions.ts.
  Resident
  HealthcareWorker
  LabTechnician
  /// Manages a single hospital's doctors, patients-in-context and operations.
  /// Deliberately NOT the same role as Admin — Admin is walled off from all
  /// clinical/patient access by design (see careRelationship.service.ts);
  /// HospitalAdmin needs exactly that access, scoped to one hospital.
  HospitalAdmin

  @@map("role_name")
}

/// Biological sex / gender identity for patient demographics.
/// PreferNotToDisclose satisfies privacy requirements.
enum Gender {
  Male
  Female
  Other
  PreferNotToDisclose

  @@map("gender")
}

/// Blood group classification using ABO + Rh system.
enum BloodGroup {
  A_Positive
  A_Negative
  B_Positive
  B_Negative
  AB_Positive
  AB_Negative
  O_Positive
  O_Negative
  Unknown

  @@map("blood_group")
}

/// Marital status for patient demographics.
enum MaritalStatus {
  Single
  Married
  Divorced
  Widowed
  Separated
  PreferNotToDisclose

  @@map("marital_status")
}

/// Smoking status for lifestyle assessment.
enum SmokingStatus {
  Never
  Former
  Current
  Occasional

  @@map("smoking_status")
}

/// Alcohol consumption status.
enum AlcoholStatus {
  Never
  Occasional
  Moderate
  Heavy

  @@map("alcohol_status")
}

/// Tobacco use status (includes smokeless tobacco).
enum TobaccoStatus {
  Never
  Former
  Current

  @@map("tobacco_status")
}

/// Physical activity level for lifestyle assessment.
enum PhysicalActivity {
  Sedentary
  Light
  Moderate
  Active
  VeryActive

  @@map("physical_activity")
}

/// Severity classification for audit events.
/// Used for alerting thresholds in future SIEM integration.
enum AuditSeverity {
  Info
  Warning
  Critical

  @@map("audit_severity")
}

/// All security-relevant actions that must be audited.
/// Extend this enum as new modules are added — never remove values.
enum AuditAction {
  UserRegistered
  UserLoginSuccess
  UserLoginFailed
  UserLogout
  PasswordChanged
  AccountLocked
  AccountUnlocked
  EmailVerified
  UnauthorizedAccess
  ProfileUpdated
  ProfilePhotoUpdated
  RoleChanged
  AccountDeleted
  // ── Session lifecycle (refresh-token rotation) ──────────────────────────
  TokenRefreshed
  TokenReuseDetected
  SessionRevoked
  // ── Patient identity & encounters (Phase 6) ─────────────────────────────
  PatientRegistered
  PatientSearched
  PatientRecordViewed
  PatientDuplicateDetected
  PatientDuplicateAcknowledged
  PatientAccountLinked
  EncounterCreated
  EncounterClosed
  AssessmentCreated
  AssessmentUpdated
  AiMessageSent
  AiResponseGenerated
  AiEmergencyInterlockTriggered
  AiOutputBlocked
  AiBudgetExceeded
  AiPolicyBlocked
  AiProviderError
  AiConversationDeleted
  // ── Hospital Admin / three-role onboarding ──────────────────────────────
  HospitalAdminRegistered
  DoctorAvailabilityUpdated
  FeedbackSubmitted
  // ── Care-team membership ────────────────────────────────────────────────
  // Who may read a patient's record is decided by care-team membership, so
  // granting and ending one is an authorization change and audited as such.
  CareTeamAssigned
  CareTeamEnded
  // ── Appointments ────────────────────────────────────────────────────────
  // Appointment writes previously logged as ProfileUpdated with an
  // `operation` discriminator in metadata, which made them invisible to any
  // query filtering by action.
  AppointmentCreated
  AppointmentRescheduled
  AppointmentStatusChanged
  AppointmentCancelled
  // ── Clinical notes ──────────────────────────────────────────────────────
  NoteCreated
  NoteSigned
  NoteAmended
  // ── Clinical authoring (M-06) ───────────────────────────────────────────
  NoteCosigned
  NoteReturnedToAuthor
  ProblemAdded
  ProblemResolved
  PrescriptionCreated
  PrescriptionSigned
  InstructionsIssued
  TemplateSaved
  TemplatePromoted
  // ── Deterministic safety (UI_ATLAS §4.9) ────────────────────────────────
  // HardStopOverridden is the one event that must ALERT, not merely record:
  // it is a G4 override of a deterministic rule and is reviewed within 24h.
  HardStopTriggered
  HardStopOverridden
  // ── Break-glass (DD-014) ────────────────────────────────────────────────
  BreakGlassRequested
  BreakGlassGranted
  BreakGlassReviewed

  @@map("audit_action")
}

// =============================================================================
// ROLE
//
// Separated from User to allow RBAC expansion without touching the users table.
// Future: add a `level` (Int) field for role hierarchy if privilege escalation
// checks are needed.
// =============================================================================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // ── Relations ───────────────────────────────────────────────────────────
  users           User[]
  rolePermissions RolePermission[]

  // ── Index: isActive for filtering inactive roles ─────────────────────────
  @@index([isActive])
  @@map("roles")
}

// =============================================================================
// PERMISSION
//
// Foundation scaffold. Currently unpopulated.
// Module-level permissions are added here as new domains are built.
// Example records:
//   { name: "patient:read",   resource: "patient", action: "read"   }
//   { name: "lab:create",     resource: "lab",     action: "create" }
//
// resource + action combination is the functional unique key.
// =============================================================================

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique // e.g. "patient:read"
  description String?
  resource    String // e.g. "patient", "lab_report"
  action      String // e.g. "create", "read", "update", "delete"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // ── Relations ───────────────────────────────────────────────────────────
  rolePermissions RolePermission[]

  // ── Composite index: most queries filter by resource + action ────────────
  @@index([resource, action])
  @@map("permissions")
}

// =============================================================================
// ROLE_PERMISSION  (Join Table — Many-to-Many: Role ↔ Permission)
//
// Composite PK prevents duplicate role-permission assignments.
// Cascade delete on both sides: removing a role or permission
// automatically cleans up the assignment. No orphaned rows.
// =============================================================================

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  // ── Relations ───────────────────────────────────────────────────────────
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =============================================================================
// USER
//
// Authentication and identity ONLY.
// No name. No phone number. No date of birth. No medical information.
// Profile data lives in PatientProfile / DoctorProfile (future) / etc.
//
// Security fields explained:
//  failedLoginAttempts — incremented on each failed login; reset on success.
//  lockedUntil         — if set and in the future, login is rejected.
//  lastLoginAt         — audit trail; detect stale/unused accounts.
//  passwordChangedAt   — detect accounts that never changed default passwords.
//  verificationToken   — one-time token for email verification flow.
//  verificationExpires — token expiry; must be checked before accepting token.
//  deletedAt           — soft delete; row is retained, login is rejected.
// =============================================================================

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  passwordHash String @map("password_hash")

  // ── Role FK ──────────────────────────────────────────────────────────────
  roleId String @map("role_id") @db.Uuid

  // ── Account Status ────────────────────────────────────────────────────────
  isVerified Boolean @default(false) @map("is_verified")
  isActive   Boolean @default(true) @map("is_active")

  // ── Security Fields ───────────────────────────────────────────────────────
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  passwordChangedAt   DateTime? @map("password_changed_at")

  // ── Email Verification ────────────────────────────────────────────────────
  // verificationToken is UNIQUE: prevents token collision across users.
  // It is nullable: NULL when the account is already verified.
  verificationToken   String?   @unique @map("verification_token")
  verificationExpires DateTime? @map("verification_expires")

  // ── Consent ───────────────────────────────────────────────────────────────
  // Set when the registration form's "I agree to Terms & Privacy" checkbox is
  // checked. Previously collected client-side and silently discarded before
  // reaching the server — this is the fix for that gap.
  termsAcceptedAt DateTime? @map("terms_accepted_at")
  termsVersion    String?   @map("terms_version")

  // ── Soft Delete ───────────────────────────────────────────────────────────
  deletedAt DateTime? @map("deleted_at")

  // ── Timestamps ────────────────────────────────────────────────────────────
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ── Relations ─────────────────────────────────────────────────────────────
  role                Role                 @relation(fields: [roleId], references: [id])
  patientProfile      PatientProfile?
  doctorProfile       DoctorProfile?
  staffProfile        StaffProfile?
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  notifications       Notification[]
  aiConversations     AiConversation[]
  aiMemoryChunks      AiMemoryChunk[]

  // ── Indexes ───────────────────────────────────────────────────────────────
  // email: @unique creates the lookup index implicitly — not duplicated here.
  //
  // [roleId]: FK columns must be indexed; Prisma does NOT auto-index FKs.
  // PostgreSQL will use this for JOIN queries against the roles table.
  //
  // [isActive, deletedAt]: compound index for the most common query pattern:
  //   WHERE is_active = true AND deleted_at IS NULL
  //
  // [createdAt]: range queries for admin dashboards and reporting.
  @@index([roleId])
  @@index([isActive, deletedAt])
  @@index([createdAt])
  @@map("users")
}

// =============================================================================
// PATIENT PROFILE
//
// Comprehensive patient identity, demographics, contact, lifestyle, and
// medical summary information. One-to-one with User.
//
// This table serves as the central source of truth for patient identity.
// Clinical data (diagnoses, lab results, NGS) lives in future domain tables.
//
// onDelete: Restrict — a User with a PatientProfile cannot be hard-deleted.
// This is a DB-level guard. The application must soft-delete via deletedAt.
// This prevents accidental permanent loss of patient records.
//
// profilePhoto: stores only the filename/path — binary data NEVER goes in DB.
// =============================================================================

model PatientProfile {
  id     String  @id @default(uuid()) @db.Uuid
  // Nullable as of Phase 6: a staff/field-registered patient (e.g. an
  // unconscious ambulance arrival) has no email/password and therefore no
  // User row yet. `link-account` attaches one later. Postgres unique indexes
  // permit any number of NULLs, so multiple login-less patients coexist
  // without conflict. All pre-Phase-6 rows keep their non-null userId.
  userId String? @unique @map("user_id") @db.Uuid

  // ── Platform identity (Phase 6) ────────────────────────────────────────────
  // Public-facing, stable, non-enumerable identifier. Never the internal
  // UUID — see server/src/utils/shriId.ts for the generation scheme.
  shriPatientId String @unique @map("shri_patient_id")

  // Deterministic HMAC-SHA256 blind index of the normalized mobile number
  // (see server/src/utils/phone.ts + hmacBlindIndex in encryption.ts).
  // Deliberately NOT @unique: verified against live data, a single mobile
  // handset is legitimately shared by more than one family member/patient.
  // A strong signal for duplicate detection, never an identity guarantee.
  phoneNumberHash String? @map("phone_number_hash")

  /// True only for fabricated demonstration records. The AI assistant refuses
  /// to send anything else to a provider when AI_DATA_POLICY=synthetic-only,
  /// which is the default. Fails closed: absent or false means "real".
  isSyntheticData Boolean @default(false) @map("is_synthetic_data")

  aiMemoryChunks AiMemoryChunk[]

  /// Set once the Required-tier onboarding fields are filled and the patient
  /// has passed the "enter the app" gate. Null means still onboarding.
  /// Recommended/Optional fields remain fillable later regardless of this.
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  registrationSource RegistrationSource @default(SelfRegistered) @map("registration_source")
  // Set only when registrationSource is Staff/FieldRegistered. The User who
  // performed the registration — used by the HealthcareWorker care-relationship
  // grant (see careRelationship.service.ts) since a field worker has no
  // CareTeamMember row.
  registeredByUserId String?            @map("registered_by_user_id") @db.Uuid
  identityStatus     IdentityStatus     @default(Unverified) @map("identity_status")

  // ── Basic Information ─────────────────────────────────────────────────────
  firstName      String         @map("first_name")
  middleName     String?        @map("middle_name")
  lastName       String         @map("last_name")
  // Nullable as of Phase 6: an unconscious/unidentified patient may have no
  // known DOB. dobIsEstimated distinguishes a real recorded value from a
  // clinician's best guess — never silently treated the same as a confirmed
  // date (age-based dosing depends on this distinction).
  dateOfBirth    DateTime?      @map("date_of_birth") @db.Date
  dobIsEstimated Boolean        @default(false) @map("dob_is_estimated")
  gender         Gender?
  bloodGroup     BloodGroup?    @map("blood_group")
  maritalStatus  MaritalStatus? @map("marital_status")

  // ── Profile Photo ─────────────────────────────────────────────────────────
  // Stores only the relative filename — e.g. "uuid.jpg"
  // Full URL is constructed at the service layer.
  // Binary data NEVER stored in PostgreSQL.
  profilePhoto  String?       @map("profile_photo")
  photoMetadata ProfilePhoto?

  // ── Identification ────────────────────────────────────────────────────────
  // abhaId is stored ENCRYPTED (AES-256-GCM, random IV per value) — see
  // server/src/utils/encryption.ts. Because a random IV means the same
  // plaintext never re-encrypts to the same ciphertext, uniqueness can't be
  // enforced on this column directly. abhaIdHash is a deterministic
  // HMAC-SHA256 blind index of the plaintext, carrying the @unique
  // constraint instead — the encrypted value is never used for lookups.
  abhaId         String? @map("abha_id")
  abhaIdHash     String? @unique @map("abha_id_hash")
  passportNumber String? @map("passport_number")
  // Only the last 4 digits are ever accepted or stored — the full 12-digit
  // Aadhaar number is never persisted, so there is no "full identifier" to
  // secure/migrate later. Displayed to the user as e.g. "XXXX-XXXX-1234".
  // Stored encrypted — no longer a fixed-width column (ciphertext is longer
  // than 4 chars).
  aadhaarLast4   String? @map("aadhaar_last4")

  // ── Contact ───────────────────────────────────────────────────────────────
  // phoneNumber/alternatePhone/address* are stored ENCRYPTED (see abhaId
  // comment above for the encryption scheme). country is left plaintext —
  // low sensitivity, used as a display default.
  phoneNumber    String? @map("phone_number")
  alternatePhone String? @map("alternate_phone")
  addressLine1   String? @map("address_line1")
  addressLine2   String? @map("address_line2")
  village        String?
  city           String?
  district       String?
  state          String?
  country        String? @default("India")
  postalCode     String? @map("postal_code")

  // ── Emergency Contact ─────────────────────────────────────────────────────
  // Stored ENCRYPTED.
  emergencyContactName     String? @map("emergency_contact_name")
  emergencyContactPhone    String? @map("emergency_contact_phone")
  emergencyContactRelation String? @map("emergency_contact_relation")

  // ── Lifestyle ─────────────────────────────────────────────────────────────
  smokingStatus    SmokingStatus?    @map("smoking_status")
  alcoholStatus    AlcoholStatus?    @map("alcohol_status")
  tobaccoStatus    TobaccoStatus?    @map("tobacco_status")
  physicalActivity PhysicalActivity? @map("physical_activity")
  occupation       String?

  // ── Medical Summary ───────────────────────────────────────────────────────
  // Stored as plain text / comma-separated lists, ENCRYPTED.
  // Future: normalize to separate tables per domain requirement.
  knownAllergies     String? @map("known_allergies")
  currentMedications String? @map("current_medications")
  existingDiseases   String? @map("existing_diseases")
  familyHistory      String? @map("family_history")
  previousSurgeries  String? @map("previous_surgeries")

  // ── Preferences ───────────────────────────────────────────────────────────
  // Notification/privacy/accessibility/language settings from the Settings
  // page. Not sensitive PII — stored as plaintext JSON, not encrypted.
  preferences Json?

  // ── Soft Delete ───────────────────────────────────────────────────────────
  deletedAt DateTime? @map("deleted_at")

  // ── Timestamps ────────────────────────────────────────────────────────────
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ── Relations ─────────────────────────────────────────────────────────────
  // Nullable relation to match nullable userId — a login-less patient has no
  // linked User row until link-account is used.
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  careTeam      CareTeamMember[]
  appointments  Appointment[]
  encounters    Encounter[]
  feedback      Feedback[]
  clinicalNotes ClinicalNote[]

  // ── Clinical authoring (M-06) ─────────────────────────────────────────────
  problems         Problem[]
  prescriptions    Prescription[]
  instructions     PatientInstruction[]
  breakGlassGrants BreakGlassGrant[]

  // ── Indexes ───────────────────────────────────────────────────────────────
  // [lastName, firstName]: name search — clinical staff search patients by name.
  // [abhaIdHash]: @unique blind-index look-up — abhaId itself is encrypted
  // and can't be looked up or constrained directly (see comment above).
  // [phoneNumberHash]: NOT unique — see field comment above.
  // [dateOfBirth]: supports the name+DOB duplicate-matching signal.
  // [registrationSource, createdAt]: lets ops queries filter field/staff
  // registrations without a full table scan.
  // userId / shriPatientId: @unique creates the index implicitly — not duplicated.
  @@index([lastName, firstName])
  @@index([phoneNumberHash])
  @@index([dateOfBirth])
  @@index([registrationSource, createdAt])
  @@map("patient_profiles")
}

enum RegistrationSource {
  /// The existing self-service flow — POST /auth/register. Default value:
  /// correct for every row that existed before Phase 6.
  SelfRegistered
  /// Front-desk / clinic staff registered the patient in person.
  StaffRegistered
  /// Ambulance, health camp, or other low-connectivity field registration.
  FieldRegistered
  /// Reserved for a future bulk/HMIS import path. Not implemented.
  Imported

  @@map("registration_source")
}

enum IdentityStatus {
  /// Name/DOB given verbally, nothing independently checked.
  Unverified
  /// Patient could not identify themselves (e.g. unconscious); a placeholder
  /// name was recorded. Never used for anything beyond a display flag.
  Provisional
  /// ABHA or another document has been checked against this record.
  Verified
  /// This record lost a duplicate-merge decision. No code path sets this yet
  /// — merging is a deliberately unbuilt, destructive operation (see
  /// patient.identity.service.ts) — but the state has a home in the schema
  /// for when a real merge workflow is authorized.
  MergedAway

  @@map("identity_status")
}

// =============================================================================
// AUDIT LOG
//
// Immutable append-only table. INSERT only. No UPDATE. No DELETE. Ever.
// Retained indefinitely per HIPAA Security Rule §164.312(b) and GDPR Article 30.
//
// userId is nullable because:
//  1. System-initiated events have no user context.
//  2. onDelete: SetNull — if a user is deleted, their audit history is
//     preserved with userId = NULL. The log must never be destroyed.
//
// No updatedAt field — adding one would be architecturally incorrect for
// an immutable audit trail. Prisma's @updatedAt would allow mutation.
//
// metadata (Json/jsonb): flexible payload for action-specific context.
// Example: { "ip": "1.2.3.4", "reason": "max_attempts_exceeded" }
// =============================================================================

model AuditLog {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String?       @map("user_id") @db.Uuid
  action     AuditAction
  resource   String? // e.g. "user", "patient_profile"
  resourceId String?       @map("resource_id") // UUID of the affected row
  severity   AuditSeverity @default(Info)
  ipAddress  String?       @map("ip_address")
  userAgent  String?       @map("user_agent")
  metadata   Json?

  // No updatedAt — this field's absence is intentional and enforced.
  createdAt DateTime @default(now()) @map("created_at")

  // ── Relations ─────────────────────────────────────────────────────────────
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // ── Indexes ───────────────────────────────────────────────────────────────
  // [userId]: look up all events for a specific user (account activity view)
  // [action]: filter by event type (find all failed logins)
  // [severity]: alert dashboards filter on Critical events.
  // [createdAt]: time-range queries — the primary access pattern for audit logs.
  // [userId, action, createdAt]: the most common security query:
  //   "Show me all failed login attempts for user X in the last 30 days"
  //   This compound index satisfies that query without a table scan.
  @@index([userId])
  @@index([action])
  @@index([severity])
  @@index([createdAt])
  @@index([userId, action, createdAt])
  @@map("audit_logs")
}

// =============================================================================
// PROFILE PHOTO METADATA
//
// Metadata for the patient's profile photo upload.
// One-to-one with PatientProfile.
// =============================================================================
model ProfilePhoto {
  id               String   @id @default(uuid()) @db.Uuid
  patientProfileId String   @unique @map("patient_profile_id") @db.Uuid
  filename         String
  path             String
  mimeType         String   @map("mime_type")
  uploadedAt       DateTime @default(now()) @map("uploaded_at")

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@map("profile_photos")
}

// =============================================================================
// PASSWORD RESET TOKEN
//
// Dedicated single-use password reset token store.
// Raw tokens are NEVER stored — only SHA-256 token hashes are persisted.
// Expired or used tokens are rejected.
// =============================================================================
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// =============================================================================
// REFRESH TOKEN
//
// Enables short-lived access tokens (15 min) without logging the patient out
// every 15 minutes — the single biggest usability defect found in the Phase 1
// audit.
//
// Security model mirrors PasswordResetToken, with rotation added:
//  - Raw tokens are NEVER stored. Only a SHA-256 hash is persisted.
//  - Single use: refreshing consumes the token (revokedAt set) and issues a
//    new one. `replacedBy` chains the rotation so a whole family is traceable.
//  - Reuse detection: presenting an already-revoked token means the token was
//    stolen (the legitimate client already rotated it). The correct response is
//    to revoke the ENTIRE family, forcing re-authentication. `familyId` groups
//    every token descended from one login for exactly this purpose.
//  - deviceLabel/ipAddress/userAgent let a patient see and revoke their own
//    sessions later without another schema change.
// =============================================================================
model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  tokenHash String @unique @map("token_hash")

  /// All tokens rotated from a single login share this id.
  familyId String @map("family_id") @db.Uuid

  /// Set when this token is rotated away or explicitly revoked. Non-null = unusable.
  revokedAt  DateTime? @map("revoked_at")
  /// Hash of the token that replaced this one — audit trail for rotation.
  replacedBy String?   @map("replaced_by")

  expiresAt DateTime @map("expires_at")

  // ── Session context (for a future "your devices" screen) ─────────────────
  deviceLabel String? @map("device_label")
  ipAddress   String? @map("ip_address")
  userAgent   String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// =============================================================================
// DOCTOR PROFILE
//
// The Doctor portal is NOT built in Phase 2 — but the identity it will need is
// modelled now so adding it later is additive rather than a restructure.
//
// registrationNumber is the state medical council registration; hprId is the
// ABDM Healthcare Professional Registry id. Both are unique when present, and
// both are the fields a patient-facing "verified doctor" badge would check.
// =============================================================================
model DoctorProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  gender    Gender?

  /// State medical council registration number.
  registrationNumber String? @unique @map("registration_number")
  /// ABDM Healthcare Professional Registry id.
  hprId              String? @unique @map("hpr_id")

  specialty       String?
  qualifications  String?
  /// Free text fallback — kept for legacy/unmatched rows. A doctor who
  /// selects a real Hospital during onboarding gets hospitalId set instead;
  /// this stays populated too so existing display code needs no branching.
  hospitalName    String? @map("hospital_name")
  /// Structured link, added once a Hospital model existed to justify it.
  /// Nullable: an independent/unaffiliated doctor has no hospital at all.
  hospitalId      String? @map("hospital_id") @db.Uuid
  yearsExperience Int?    @map("years_experience")

  /// Set by an administrator (Hospital Admin, or the global Admin for a
  /// hospital's first doctor) once credentials are checked. Never
  /// self-service, and never a login gate — see onboarding decision notes.
  isVerified       Boolean   @default(false) @map("is_verified")
  verifiedAt       DateTime? @map("verified_at")
  /// Plain field, same pattern as PatientProfile.registeredByUserId — no
  /// formal relation needed for a one-directional attribution column.
  verifiedByUserId String?   @map("verified_by_user_id") @db.Uuid

  /// Set once the Required-tier onboarding fields (specialty, hospital
  /// choice, experience) are filled. Recommended/Optional (qualifications,
  /// registration number, HPR id, photo) and Availability remain fillable
  /// later regardless of this.
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  phoneNumber  String? @map("phone_number")
  profilePhoto String? @map("profile_photo")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  hospital     Hospital?            @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  careTeam     CareTeamMember[]
  appointments Appointment[]
  availability DoctorAvailability[]
  leaves       DoctorLeave[]
  feedback     Feedback[]

  @@index([lastName, firstName])
  @@index([specialty])
  @@index([hospitalId])
  @@map("doctor_profiles")
}

// =============================================================================
// STAFF PROFILE
//
// Covers Admin, HealthcareWorker and LabTechnician — roles that need an
// identity and a department but not a clinician's credentials. One table rather
// than three near-identical ones; the role still lives on User.roleId, so this
// does not duplicate role logic.
// =============================================================================
model StaffProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  firstName String @map("first_name")
  lastName  String @map("last_name")

  /// Free-text job title, e.g. "Stroke Care Coordinator".
  jobTitle   String? @map("job_title")
  department String?
  employeeId String? @unique @map("employee_id")

  /// Only meaningful for HospitalAdmin rows today. Nullable: Admin and
  /// LabTechnician have no hospital affiliation concept.
  hospitalId String? @map("hospital_id") @db.Uuid

  /// StaffProfile previously had no verification concept at all. Added for
  /// HospitalAdmin, mirroring DoctorProfile.isVerified: never a login gate,
  /// a credential-check/badge flag another administrator sets.
  isVerified       Boolean   @default(false) @map("is_verified")
  verifiedAt       DateTime? @map("verified_at")
  verifiedByUserId String?   @map("verified_by_user_id") @db.Uuid

  /// Set once this role's Required-tier onboarding fields are filled.
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  phoneNumber String? @map("phone_number")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([lastName, firstName])
  @@index([hospitalId])
  @@map("staff_profiles")
}

// =============================================================================
// HOSPITAL
//
// Added to back the HospitalAdmin role. Deliberately minimal: this platform
// does not need a facilities/billing/department hierarchy yet, only a stable
// entity doctors and hospital-admin staff can be scoped to. Patients are
// intentionally NOT linked here (no PatientProfile.hospitalId) — a patient
// may see doctors from more than one hospital over their lifetime, so "which
// patients belong to this hospital" is a derived query through
// CareTeamMember/Appointment → DoctorProfile.hospitalId, never a stored
// column (see hospitalAdmin.service.ts).
// =============================================================================
model Hospital {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  city     String?
  state    String?
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  doctors DoctorProfile[]
  staff   StaffProfile[]

  @@index([isActive])
  @@map("hospitals")
}

// =============================================================================
// DOCTOR AVAILABILITY / LEAVE
//
// Recurring weekly hours a doctor can be booked in, plus leave periods that
// override them. Deliberately NOT wired into the appointment booking flow
// yet (Appointment.scheduledAt is still freely chosen) — that integration is
// a real follow-up, kept out of this phase to bound scope. Today these are
// visible to the doctor (self-service) and to their Hospital Admin.
// =============================================================================
model DoctorAvailability {
  id       String @id @default(uuid()) @db.Uuid
  doctorId String @map("doctor_id") @db.Uuid

  /// 0=Sunday..6=Saturday.
  dayOfWeek Int    @map("day_of_week")
  /// "HH:mm", 24-hour, no date component — validated at the service layer.
  startTime String @map("start_time")
  endTime   String @map("end_time")

  slotDurationMins Int     @default(30) @map("slot_duration_mins")
  isActive         Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek])
  @@map("doctor_availability")
}

model DoctorLeave {
  id       String @id @default(uuid()) @db.Uuid
  doctorId String @map("doctor_id") @db.Uuid

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  reason    String?

  createdAt DateTime @default(now()) @map("created_at")

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startDate, endDate])
  @@map("doctor_leaves")
}

// =============================================================================
// FEEDBACK
//
// Patient-authored feedback on a doctor, a hospital's service, or the app
// itself. `comment` is encrypted at rest — the same rule as every other
// patient-authored free-text field (see PatientProfile's medical summary
// fields). Hospital Admin reads this aggregated and scoped to their own
// hospital's doctors, never as a raw per-patient feed (see feedback.service.ts).
// =============================================================================
enum FeedbackCategory {
  DoctorExperience
  HospitalService
  AppUsability
  Other

  @@map("feedback_category")
}

model Feedback {
  id            String  @id @default(uuid()) @db.Uuid
  patientId     String  @map("patient_id") @db.Uuid
  doctorId      String? @map("doctor_id") @db.Uuid
  appointmentId String? @map("appointment_id") @db.Uuid

  category FeedbackCategory
  /// 1-5, validated at the service layer (not a DB check constraint — Prisma
  /// has no portable way to express one, and the service layer already owns
  /// every other cross-field validation in this codebase).
  rating   Int
  /// Encrypted at rest — patient-authored free text about their care.
  comment  String?

  createdAt DateTime @default(now()) @map("created_at")

  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      DoctorProfile? @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  appointment Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([doctorId])
  @@index([category, createdAt])
  @@map("feedback")
}

// =============================================================================
// CARE TEAM MEMBER  (Patient ↔ Doctor assignment)
//
// The keystone of the three-role architecture. Every doctor-facing endpoint
// answers "is this patient yours?" by querying this table — which is exactly
// why profile.routes.ts currently refuses to expose GET /profile/:id: until
// now there was no relationship to authorise against.
//
// Historical rows are preserved via activeTo rather than deletion, so "who was
// on this patient's care team in March?" stays answerable.
// =============================================================================
model CareTeamMember {
  id        String @id @default(uuid()) @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  doctorId  String @map("doctor_id") @db.Uuid

  /// Role on THIS patient's care team, e.g. "Neurologist", "Physiotherapist".
  /// Distinct from the platform RoleName — a doctor's account role never changes.
  careRole  String  @map("care_role")
  isPrimary Boolean @default(false) @map("is_primary")

  activeFrom DateTime  @default(now()) @map("active_from")
  activeTo   DateTime? @map("active_to")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  /// A doctor holds one active assignment per patient. Re-assignment after an
  /// activeTo is intentionally allowed — hence the composite includes careRole.
  @@unique([patientId, doctorId, careRole])
  @@index([patientId])
  @@index([doctorId])
  @@index([patientId, activeTo])
  @@map("care_team_members")
}

// =============================================================================
// APPOINTMENT
//
// Replaces the mock booking flow, which confirmed appointments no doctor ever
// received (Phase 1 §D-C3).
//
// scheduledAt is stored as an absolute UTC instant; the client renders it in
// the patient's timezone. Never store wall-clock time without a zone.
// =============================================================================
model Appointment {
  id        String  @id @default(uuid()) @db.Uuid
  patientId String  @map("patient_id") @db.Uuid
  doctorId  String? @map("doctor_id") @db.Uuid

  scheduledAt  DateTime @map("scheduled_at")
  durationMins Int      @default(30) @map("duration_mins")

  mode   AppointmentMode   @default(InPerson)
  status AppointmentStatus @default(Requested)

  /// Patient's own words for why they are attending. Encrypted at rest.
  reason String?
  /// Clinician-authored notes. Encrypted at rest.
  notes  String?

  locationName String? @map("location_name")

  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by") @db.Uuid
  cancelReason String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  DoctorProfile? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  /// Reverse side of Encounter.appointmentId. At most one encounter links to
  /// a given appointment (enforced by @unique on that field).
  encounter     Encounter?
  feedback      Feedback[]
  clinicalNotes ClinicalNote[]

  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledAt])
  @@index([patientId, status, scheduledAt])
  @@map("appointments")
}

enum AppointmentMode {
  InPerson
  Video
  Phone

  @@map("appointment_mode")
}

enum AppointmentStatus {
  Requested
  Confirmed
  Completed
  Cancelled
  NoShow

  @@map("appointment_status")
}

// =============================================================================
// NOTIFICATION
//
// Replaces the hardcoded notification array in Topbar.jsx.
// Deliberately minimal: no delivery-channel matrix, no templating engine, no
// scheduling. Those are speculative until real notification triggers exist.
// =============================================================================
model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  type  NotificationType @default(General)
  title String
  body  String?

  /// In-app route this notification points at, e.g. "/app/appointments".
  actionUrl String? @map("action_url")

  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Covers the only two real queries: the unread badge count, and the
  /// reverse-chronological notification list.
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// =============================================================================
// AI INSIGHTS (Phase 7)
//
// Conversation history for the patient-facing assistant. The model is NOT
// wired up yet — these tables exist so the transcript is durable from day one,
// because a chat that forgets itself on refresh is not something a patient can
// rely on, and because retro-fitting persistence under a live assistant is far
// worse than having it waiting.
//
// Message bodies are ENCRYPTED at rest. A patient asking "should I be worried
// about this weakness in my arm" is writing health information as surely as
// any field on PatientProfile, and it is stored under the same rules.
//
// Scoped to User, not PatientProfile: a clinician portal will want the same
// assistant, and nothing here is patient-record-specific.
// =============================================================================
model AiConversation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Derived from the first question asked, and renameable. Encrypted for the
  /// same reason the messages are — it is usually a health question verbatim.
  title String

  /// Soft-delete. A transcript the patient removed should stop appearing
  /// without destroying an audited clinical conversation outright.
  deletedAt DateTime? @map("deleted_at")

  /// Rolling summary of turns older than the working window. ENCRYPTED, same
  /// rule as the messages it summarises. Written AFTER a reply is returned so
  /// the summariser is never on the patient's critical path.
  summary                 String?
  summaryThroughMessageId String? @map("summary_through_message_id") @db.Uuid
  summaryTokenCount       Int?    @map("summary_token_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  /// The only list query: this user's conversations, most recently used first.
  @@index([userId, deletedAt, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid

  role    AiMessageRole
  /// Encrypted at rest — see the note on AiConversation.
  content String

  /// Kept for back-compat with rows written before `kind` existed. New code
  /// reads `kind`; this stays true only for legacy placeholder rows.
  isPlaceholder Boolean @default(false) @map("is_placeholder")

  /// What actually produced this turn. `isPlaceholder` was already doing this
  /// job badly with two states, and there are now five. The transcript must
  /// never imply the assistant said something clinical that it did not, so
  /// the provenance of every turn is explicit and rendered differently.
  kind AiMessageKind @default(Model)

  /// Which safety ruleset evaluated this turn — so a behaviour change is
  /// attributable after the fact.
  safetyRuleVersion String? @map("safety_rule_version")

  createdAt DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum AiMessageRole {
  User
  Assistant

  @@map("ai_message_role")
}

enum AiMessageKind {
  /// Generated by the model and passed every output check.
  Model
  /// Written before any model was connected.
  Placeholder
  /// The deterministic emergency interlock fired; the model was never called.
  SafetyInterlock
  /// The model answered but an output check rejected it.
  SafetyBlocked
  /// Refused before calling the model because a budget was exhausted.
  BudgetDeferred
  /// Refused because this deployment may not send real patient data upstream.
  PolicyBlocked

  @@map("ai_message_kind")
}

/// Per-day AI usage. In Postgres rather than memory because a restart at 6pm
/// must not hand every patient a fresh allowance and drain the daily quota.
/// The row with a null userId is the shared/global pool.
enum AiChunkSource {
  ProfileMedical
  Appointment
  Encounter
  StrokeAssessment
  CareTeam
  ChatSummary

  @@map("ai_chunk_source")
}

/// Retrieval chunks for the AI assistant. Keyed on User (`ownerUserId`), not
/// PatientProfile: AiConversation already hangs off User, and that join is
/// nullable (staff roles have no patient profile) — keying here the same way
/// makes every retrieval a single unbranched WHERE, and gives staff users
/// conversation memory with zero clinical chunks by construction.
///
/// `content` is ENCRYPTED at rest, same rule as AiMessage.content — a
/// rendered chunk of "Known allergies: Penicillin" is health information.
/// `embedding` is therefore the one deliberately plaintext-derived surface: a
/// 384-float vector cannot itself be encrypted and remain searchable by
/// pgvector, so it is treated as sensitive derived data by access scope
/// instead (cascades with its owner and, where present, the patient).
///
/// Deliberately NO ivfflat/hnsw index (see the migration) — at the current
/// per-patient chunk count an exact scan is both faster and, unlike an ANN
/// index, cannot silently under-return a patient-scoped query.
model AiMemoryChunk {
  id          String  @id @default(uuid()) @db.Uuid
  ownerUserId String  @map("owner_user_id") @db.Uuid
  patientId   String? @map("patient_id") @db.Uuid

  sourceType  AiChunkSource @map("source_type")
  sourceId    String        @map("source_id") @db.Uuid
  /// Distinguishes multiple chunks from the same source row (e.g. two
  /// separate PatientProfile fields); empty for one-chunk-per-row sources.
  sourceField String        @default("") @map("source_field")

  content     String
  /// hmacBlindIndex(renderedText) — a keyed digest, not a bare hash, so it is
  /// not rainbow-tableable against a short string like "Penicillin".
  contentHash String @map("content_hash")
  tokenCount  Int    @map("token_count")

  /// Nullable so a chunk can exist with embedding pending (e.g. embedder
  /// temporarily unavailable) without failing the whole sync pass.
  embedding      Unsupported("vector(384)")?
  embeddingModel String?                     @map("embedding_model")

  /// The source row's own updatedAt — the cheap first gate in the three-gate
  /// freshness check (see ai/memory/chunkSync.ts). Zero decryption needed to
  /// compare this against the source table.
  sourceUpdatedAt DateTime @map("source_updated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner   User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  patient PatientProfile? @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, sourceType, sourceId, sourceField])
  @@index([ownerUserId, sourceType])
  @@map("ai_memory_chunks")
}

model AiUsageDaily {
  id     String   @id @default(uuid()) @db.Uuid
  userId String?  @map("user_id") @db.Uuid
  day    DateTime @db.Date

  requests         Int @default(0)
  promptTokens     Int @default(0) @map("prompt_tokens")
  completionTokens Int @default(0) @map("completion_tokens")
  blockedCount     Int @default(0) @map("blocked_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, day])
  @@map("ai_usage_daily")
}

enum NotificationType {
  General
  Appointment
  Report
  Medication
  CareTeam

  @@map("notification_type")
}

// =============================================================================
// ENCOUNTER (Phase 6)
//
// A Patient may have many Encounters — one per visit/episode/contact with the
// healthcare system. This is deliberately GENERIC: nothing stroke-specific
// lives here. Stroke intake hangs off an Encounter via StrokeAssessment
// (below), the same way a future OncologyAssessment or CardiologyAssessment
// would — each a pure additive table with `encounterId @unique`, requiring
// zero change to this model or to PatientProfile.
//
// onDelete: Restrict on `patient` (not Cascade, unlike Appointment/CareTeam):
// an encounter is itself a clinical record and must never be silently
// destroyed as a side effect of another operation.
// =============================================================================
model Encounter {
  id        String @id @default(uuid()) @db.Uuid
  patientId String @map("patient_id") @db.Uuid

  /// Public, immutable, server-generated. Same Crockford-Base32 scheme as
  /// shriPatientId (see server/src/utils/shriId.ts) — never updated after
  /// creation; no repository method exposes a way to change it.
  visitId String @unique @map("visit_id")

  type   EncounterType
  status EncounterStatus @default(InProgress)

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  /// Free text naming a real place ("Coimbatore field camp, block 3").
  /// Encrypted at rest — see server/src/encounter/encounter.repository.ts.
  locationName String? @map("location_name")

  /// Who opened it. Nullable: a future offline/device-originated path may
  /// have no authenticated user at capture time.
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  /// Optional link to a booked Appointment. SetNull, not Cascade/Restrict —
  /// losing the appointment (e.g. it is later deleted) must never destroy
  /// the clinical encounter record.
  appointmentId String? @unique @map("appointment_id") @db.Uuid

  /// Clinician free text — why the patient presented. Encrypted at rest.
  chiefComplaint String? @map("chief_complaint")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  strokeAssessment StrokeAssessment?
  clinicalNotes    ClinicalNote[]

  // ── Clinical authoring (M-06) ─────────────────────────────────────────────
  problems      Problem[]
  prescriptions Prescription[]
  instructions  PatientInstruction[]

  @@index([patientId, startedAt])
  @@index([status])
  @@index([type, startedAt])
  @@index([createdByUserId, startedAt])
  @@map("encounters")
}

enum EncounterType {
  ClinicVisit
  AmbulanceIntake
  Emergency
  Telehealth
  FollowUp
  Screening
  FieldRegistration

  @@map("encounter_type")
}

enum EncounterStatus {
  InProgress
  Completed
  Cancelled

  @@map("encounter_status")
}

// =============================================================================
// STROKE DOMAIN MODULE (Phase 6)
//
// This is a DOMAIN module, not part of the generic platform. It hangs off
// Encounter via a one-to-one relation and touches nothing on Patient or
// Encounter itself. A future OncologyAssessment/CardiologyAssessment is a
// pure additive CREATE TABLE following this exact shape — no migration to
// this file, no migration to Encounter or PatientProfile.
//
// A polymorphic single "Assessment" table with a domain discriminator and a
// JSON payload was considered and rejected: it would make future domains
// "free" at the cost of destroying type safety on values where a wrong entry
// is a patient-harm event (a JSON key can't be validated by an index, and a
// mistyped LKW timestamp buried in a blob is much easier to miss than one in
// a typed, indexed column).
// =============================================================================
model StrokeAssessment {
  id          String @id @default(uuid()) @db.Uuid
  encounterId String @unique @map("encounter_id") @db.Uuid

  // ── Last Known Well ────────────────────────────────────────────────────────
  // The single most consequential value in acute stroke care — it gates
  // thrombolysis eligibility. See StrokeLkwRevision below: every change to
  // these three fields must be independently, transactionally recorded.
  lkwAt        DateTime?    @map("lkw_at")
  lkwCertainty LkwCertainty @default(Unknown) @map("lkw_certainty")
  lkwSource    LkwSource?   @map("lkw_source")
  /// Free text context ("wife last saw him normal at dinner"). Encrypted.
  lkwNote      String?      @map("lkw_note")

  // ── Symptom flags ──────────────────────────────────────────────────────────
  // A checklist of REPORTED symptoms, not a diagnosis. The service layer
  // must never render or log any of this as "patient has stroke" — only as
  // "potential stroke symptoms identified" (see encounter.service.ts).
  facialWeakness      Boolean @default(false) @map("facial_weakness")
  armWeakness         Boolean @default(false) @map("arm_weakness")
  legWeakness         Boolean @default(false) @map("leg_weakness")
  speechDifficulty    Boolean @default(false) @map("speech_difficulty")
  suddenConfusion     Boolean @default(false) @map("sudden_confusion")
  visionProblem       Boolean @default(false) @map("vision_problem")
  severeHeadache      Boolean @default(false) @map("severe_headache")
  balanceProblem      Boolean @default(false) @map("balance_problem")
  lossOfConsciousness Boolean @default(false) @map("loss_of_consciousness")
  /// Free text for a symptom not covered above. Encrypted.
  otherSymptomNote    String? @map("other_symptom_note")

  /// True only when at least one symptom flag above is set AND the encounter
  /// type indicates urgency. This is a WORKFLOW SIGNAL — routes the patient
  /// to the right queue faster — never presented as a diagnosis.
  urgentFlag Boolean @default(false) @map("urgent_flag")

  onAnticoagulants Boolean? @map("on_anticoagulants")

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  encounter  Encounter           @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  lkwHistory StrokeLkwRevision[]

  @@index([lkwAt])
  @@index([urgentFlag])
  @@map("stroke_assessments")
}

enum LkwCertainty {
  /// Witnessed; the clock time is known and trusted.
  Exact
  /// A window is known ("around 8pm") but not a precise time.
  Approximate
  /// Wake-up stroke — LKW is the time the patient was last seen normal
  /// before sleep, not the time symptoms were noticed.
  WakeUp
  Unknown

  @@map("lkw_certainty")
}

enum LkwSource {
  Patient
  Family
  Bystander
  EmergencyServices
  ClinicalRecord

  @@map("lkw_source")
}

/// Append-only revision log for Last Known Well. Written in the SAME
/// transaction as the StrokeAssessment update that changes lkwAt/lkwCertainty
/// — never relying solely on the fire-and-forget AuditLog, whose own service
/// explicitly swallows write failures (acceptable for "someone viewed a
/// page", not acceptable for the value that gates thrombolysis). A generic
/// AuditLog row is additionally emitted for the security trail — this is the
/// one place that duplication is deliberate.
model StrokeLkwRevision {
  id           String @id @default(uuid()) @db.Uuid
  assessmentId String @map("assessment_id") @db.Uuid

  previousLkwAt     DateTime?     @map("previous_lkw_at")
  previousCertainty LkwCertainty? @map("previous_certainty")
  newLkwAt          DateTime?     @map("new_lkw_at")
  newCertainty      LkwCertainty  @map("new_certainty")
  newSource         LkwSource?    @map("new_source")

  /// Why it changed. Required — a change to this value with no stated
  /// reason is exactly the gap a later incident review would need filled.
  /// Encrypted at rest.
  reason          String
  changedByUserId String?  @map("changed_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  assessment StrokeAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, createdAt])
  @@map("stroke_lkw_revisions")
}

// =============================================================================
// CLINICAL NOTE — the consultation record
// =============================================================================

enum ClinicalNoteStatus {
  Draft
  /// Authored by someone without `note:sign:own`. Read-only to the author
  /// and NOT yet the legal record — it becomes Signed only when a consultant
  /// counter-attests it in S-06-09.
  CosignPending
  Signed

  @@map("clinical_note_status")
}

/// A clinician's consultation note, in the SOAP structure UI_ATLAS S-06-03
/// specifies (Subjective / Objective / Assessment / Plan) plus a coded
/// problem and an attestation.
///
/// ⚠️ A SIGNED NOTE IS NEVER EDITED — only amended, via ClinicalNoteAddendum.
/// That is NABH (CMP-NABH-10) and it is enforced in the repository, which
/// scopes every content update to `status: Draft`, not merely hidden in the
/// UI. The same discipline as StrokeLkwRevision, which keeps an append-only
/// side-log rather than overwriting a safety-critical value.
model ClinicalNote {
  id        String @id @default(uuid()) @db.Uuid
  patientId String @map("patient_id") @db.Uuid

  /// Optional links to the visit this note documents. Both are nullable: a
  /// note may be written outside any booked appointment or opened encounter.
  encounterId   String? @map("encounter_id") @db.Uuid
  appointmentId String? @map("appointment_id") @db.Uuid

  /// The authoring clinician's User id. A plain column, not a relation —
  /// the same pattern as Encounter.createdByUserId.
  authorUserId String @map("author_user_id") @db.Uuid

  /// The four SOAP sections. All clinician-authored free text about a
  /// patient, so all four are ENCRYPTED at rest — see
  /// clinicalNote.repository.ts's NOTE_ENCRYPTED_FIELDS.
  subjective String?
  objective  String?
  assessment String?
  plan       String?

  /// ICD-10 leaf code and its label. Not encrypted: a diagnosis code is
  /// indexed and reported on, and the code alone is meaningless without the
  /// patient row it hangs off, which is itself access-controlled.
  problemCode String? @map("problem_code")
  problemText String? @map("problem_text")

  status ClinicalNoteStatus @default(Draft)

  /// Attestation. STAMPED AT SIGN TIME FROM THE SESSION, never typed by the
  /// author — CMP-NABH-11 requires author identity, registration number and
  /// timestamp on the legal record, and a typed name is not an attestation.
  /// The name and registration number are copied rather than joined so the
  /// record still reads correctly if the doctor later changes either.
  signedAt                 DateTime? @map("signed_at")
  signedByUserId           String?   @map("signed_by_user_id") @db.Uuid
  signerName               String?   @map("signer_name")
  signerRegistrationNumber String?   @map("signer_registration_number")

  /// Co-signature (CMP-NABH-03). Stamped ALONGSIDE the author's attestation,
  /// never replacing it — the record must show who wrote it and who stood
  /// behind it. `requiresCosign` is decided at sign time from the author's
  /// capabilities, not from their role name.
  requiresCosign             Boolean   @default(false) @map("requires_cosign")
  cosignedAt                 DateTime? @map("cosigned_at")
  cosignedByUserId           String?   @map("cosigned_by_user_id") @db.Uuid
  cosignerName               String?   @map("cosigner_name")
  cosignerRegistrationNumber String?   @map("cosigner_registration_number")

  /// Returned to the author for revision instead of co-signed. The reason is
  /// mandatory and ENCRYPTED; the author is notified.
  returnedAt   DateTime? @map("returned_at")
  returnReason String?   @map("return_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient     PatientProfile         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter   Encounter?             @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  appointment Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  addenda     ClinicalNoteAddendum[]

  @@index([patientId, createdAt])
  @@index([authorUserId, createdAt])
  @@index([encounterId])
  @@index([status])
  @@map("clinical_notes")
}

/// An addition to an already-signed note. Append-only by construction: there
/// is no update path, so the original note and every amendment stay
/// separately attributed and separately timestamped.
model ClinicalNoteAddendum {
  id     String @id @default(uuid()) @db.Uuid
  noteId String @map("note_id") @db.Uuid

  /// Clinician free text — ENCRYPTED at rest, same as the note's own sections.
  body String

  authorUserId             String  @map("author_user_id") @db.Uuid
  authorName               String  @map("author_name")
  authorRegistrationNumber String? @map("author_registration_number")

  createdAt DateTime @default(now()) @map("created_at")

  note ClinicalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
  @@map("clinical_note_addenda")
}

// =============================================================================
// CLINICAL AUTHORING — M-06 · Outpatient Consultation & Clinical Documentation
//
// UI_ATLAS §6122–7050. The module that owns clinical authoring for outpatients.
//
// ⚠️ THE RULE THAT GOVERNS EVERYTHING BELOW (CMP-NABH-10): a signed clinical
// entry is NEVER edited — only amended, with the amendment attributed and
// timestamped. Every authoring table here therefore either has no update path
// after signing (enforced at the query level, see the repositories) or is
// append-only by construction.
//
// ⚠️ SAFETY IS DETERMINISTIC. The Drug / AllergyRule / DoseRange tables are the
// "deterministic floor retained locally" (§4.2). They are not a vendor
// knowledge base and they do not depend on any model being reachable: the
// prescription hard stop must fire identically with every AI capability off.
// =============================================================================

/// A problem stays on the list forever. Resolving it DATES it rather than
/// deleting it — a resolved diagnosis is still clinical history (S-06-05:
/// "never deletes history").
enum ProblemStatus {
  Active
  Resolved

  @@map("problem_status")
}

enum PrescriptionStatus {
  Draft
  Signed
  Cancelled

  @@map("prescription_status")
}

/// The atlas's fixed five (S-02-05 / GP-11). Not extensible without a spec
/// change — a free-text-only reason is how break-glass becomes unreviewable.
enum BreakGlassReason {
  EmergencyCare
  CoveringColleague
  OnCallReview
  QualityReview
  Other

  @@map("break_glass_reason")
}

enum BreakGlassOutcome {
  Appropriate
  Inappropriate

  @@map("break_glass_outcome")
}

enum TemplateScope {
  Personal
  Facility

  @@map("template_scope")
}

/// ICD-10 catalogue. `isLeaf` is the entire point of this table: S-06-05
/// blocks coding a problem to a parent-only category. "J18" is a category,
/// not a diagnosis; "J18.9" is. Seeded from UI_ATLAS §8.5's fixed list.
model DiagnosisCode {
  code  String @id
  title String

  /// Parent category, e.g. J18.9 → J18. Null at the top of a chapter.
  parentCode String? @map("parent_code")

  /// ⚠️ Only a leaf may be attached to a Problem or a ClinicalNote.
  isLeaf   Boolean @default(true) @map("is_leaf")
  isActive Boolean @default(true) @map("is_active")

  problems Problem[]

  @@index([title])
  @@index([parentCode])
  @@map("diagnosis_codes")
}

/// A patient-level problem list entry.
///
/// Distinct from ClinicalNote.problemCode, which records what ONE note was
/// about. This persists across encounters and is what S-06-05 curates.
model Problem {
  id        String @id @default(uuid()) @db.Uuid
  patientId String @map("patient_id") @db.Uuid

  /// The encounter it was first coded in, for provenance. Nullable — a problem
  /// may be carried forward from before the system held the patient.
  onsetEncounterId String? @map("onset_encounter_id") @db.Uuid

  code String

  /// Denormalised label, copied not joined, so the list still reads correctly
  /// if the catalogue is later re-versioned. Same reasoning as ClinicalNote's
  /// copied attestation.
  codeTitle String @map("code_title")

  status     ProblemStatus @default(Active)
  onsetDate  DateTime?     @map("onset_date") @db.Date
  resolvedAt DateTime?     @map("resolved_at")

  /// Clinician free text about this problem — ENCRYPTED at rest.
  note String?

  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  diagnosisCode  DiagnosisCode  @relation(fields: [code], references: [code], onDelete: Restrict)
  onsetEncounter Encounter?     @relation(fields: [onsetEncounterId], references: [id], onDelete: SetNull)

  /// ⚠️ One ACTIVE instance of a code per patient — the dedupe S-06-05
  /// requires. Expressed as a partial unique index in the migration
  /// (WHERE status = 'Active') so the same code may legitimately recur after
  /// being resolved. Prisma cannot express a partial unique index.
  @@index([patientId, status])
  @@index([code])
  @@map("problems")
}

/// A small local formulary.
///
/// ⚠️ NOT a vendor knowledge base. UI_ATLAS calls this the "deterministic floor
/// retained locally" — it exists so the safety rules below keep working with
/// every model switched off.
model Drug {
  id          String @id @default(uuid()) @db.Uuid
  genericName String @map("generic_name")
  form        String
  strength    String
  route       String

  /// The allergen class this drug belongs to, e.g. "Penicillin". Null when the
  /// drug belongs to no class anyone is recorded as allergic to. This single
  /// column is what makes the hard stop work.
  allergenClass String? @map("allergen_class")

  /// What the drug is FOR, e.g. "Antibiotic". Distinct from allergenClass,
  /// which is what it might cause a reaction to.
  ///
  /// ⚠️ Load-bearing for the hard stop's "three alternatives". Without it,
  /// "find another drug that is not a penicillin" returns a statin — which
  /// is not an alternative to an antibiotic, it is nonsense with a plausible
  /// shape. Offering no alternative is better than offering a wrong one.
  therapeuticClass String? @map("therapeutic_class")

  /// National List of Essential Medicines — CMP-DRUG-03 prompts substitution.
  isNlem   Boolean @default(false) @map("is_nlem")
  isActive Boolean @default(true) @map("is_active")

  /// ⚠️ False marks a drug added BEYOND UI_ATLAS §8.5's fixed vocabulary.
  /// §8.6 forbids inventing data, but §8.5 contains no non-beta-lactam
  /// antibiotic, so the "three alternatives" the hard stop must offer cannot
  /// be drawn from it. The additions are flagged here rather than hidden so
  /// they can be folded into §8 properly. See the migration header.
  isAtlasVocabulary Boolean @default(true) @map("is_atlas_vocabulary")

  doseRanges        DoseRange[]
  prescriptionItems PrescriptionItem[]

  @@unique([genericName, strength, form])
  @@index([genericName])
  @@map("drugs")
}

/// allergen × drug class → block.
///
/// ⚠️ THE HARD STOP IS THIS TABLE, evaluated server-side before commit. Cross
/// reactivity is modelled explicitly: a documented penicillin allergy blocks
/// piperacillin-tazobactam as well as co-amoxiclav, because both are
/// beta-lactams. That is the rule working correctly, not a false positive.
model AllergyRule {
  id String @id @default(uuid()) @db.Uuid

  /// Normalised form of what a clinician recorded in
  /// PatientProfile.knownAllergies — e.g. "penicillin".
  allergenKey String @map("allergen_key")

  /// The Drug.allergenClass this allergen blocks.
  blocksClass String @map("blocks_class")

  /// Shown verbatim in the AIP-09 gate. The clinician must be told WHY.
  rationale String

  isActive Boolean @default(true) @map("is_active")

  @@unique([allergenKey, blocksClass])
  @@map("allergy_rules")
}

/// Static dose ranges. UI_ATLAS §4.2: "static dose-range tables — never fully
/// off". Paediatric ranges are per-kg, and the UI must show the weight and its
/// capture time beside the dose (§5.4).
model DoseRange {
  id     String @id @default(uuid()) @db.Uuid
  drugId String @map("drug_id") @db.Uuid

  /// 'Adult' | 'Paediatric'
  cohort String

  minDose Decimal @map("min_dose") @db.Decimal(10, 3)
  maxDose Decimal @map("max_dose") @db.Decimal(10, 3)
  unit    String

  /// True when min/max are per kilogram of body weight.
  perKg     Boolean  @default(false) @map("per_kg")
  maxPerDay Decimal? @map("max_per_day") @db.Decimal(10, 3)

  drug Drug @relation(fields: [drugId], references: [id], onDelete: Cascade)

  @@unique([drugId, cohort])
  @@map("dose_ranges")
}

/// A prescription. Signing is irreversible and stamps the prescriber's HPR ID
/// (CMP-ABDM-07) alongside name and registration number.
model Prescription {
  id          String  @id @default(uuid()) @db.Uuid
  patientId   String  @map("patient_id") @db.Uuid
  encounterId String? @map("encounter_id") @db.Uuid

  /// RX/{fy}/{seq} — the human-facing identifier (M-06.8).
  rxNumber String @unique @map("rx_number")

  status PrescriptionStatus @default(Draft)

  authorUserId String @map("author_user_id") @db.Uuid

  /// Attestation, stamped AT SIGN TIME FROM THE SESSION — never accepted from
  /// the request. Same rule as ClinicalNote.
  signedAt                 DateTime? @map("signed_at")
  signedByUserId           String?   @map("signed_by_user_id") @db.Uuid
  signerName               String?   @map("signer_name")
  signerRegistrationNumber String?   @map("signer_registration_number")
  signerHprId              String?   @map("signer_hpr_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient   PatientProfile         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter Encounter?             @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  items     PrescriptionItem[]
  overrides PrescriptionOverride[]

  @@index([patientId, createdAt])
  @@index([encounterId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String @id @default(uuid()) @db.Uuid
  prescriptionId String @map("prescription_id") @db.Uuid
  drugId         String @map("drug_id") @db.Uuid

  dose         Decimal @db.Decimal(10, 3)
  doseUnit     String  @map("dose_unit")
  route        String
  frequency    String
  durationDays Int     @map("duration_days")

  /// Links this line to the problem it treats (S-06-07 field 5).
  indicationCode String? @map("indication_code")

  /// Drives pharmacy dispensing (CMP-DRUG-03).
  substitutionAllowed Boolean @default(true) @map("substitution_allowed")

  /// Patient-facing directions — ENCRYPTED, printed bilingually.
  instructions String?

  createdAt DateTime @default(now()) @map("created_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  drug         Drug         @relation(fields: [drugId], references: [id], onDelete: Restrict)

  @@index([prescriptionId])
  @@map("prescription_items")
}

/// A G4 override of a deterministic hard stop.
///
/// ⚠️ UI_ATLAS §4.9: `AI.SAF.HARD_STOP_OVERRIDDEN` is the ONE audit event that
/// must ALERT, not merely record, and it is reviewed within 24 hours. Both
/// identities are kept — the overriding clinician AND the second consultant
/// who authenticated. A G4 gate is not satisfied by one person twice.
model PrescriptionOverride {
  id             String @id @default(uuid()) @db.Uuid
  prescriptionId String @map("prescription_id") @db.Uuid

  /// What was blocked, captured at override time so this record stands alone
  /// even if the formulary or the rule set later changes.
  drugName    String @map("drug_name")
  allergenKey String @map("allergen_key")
  ruleText    String @map("rule_text")

  /// Mandatory justification — ENCRYPTED.
  reason String

  overriddenByUserId String @map("overridden_by_user_id") @db.Uuid
  overriddenByName   String @map("overridden_by_name")

  secondConsultantUserId             String  @map("second_consultant_user_id") @db.Uuid
  secondConsultantName               String  @map("second_consultant_name")
  secondConsultantRegistrationNumber String? @map("second_consultant_registration_number")

  /// Review within 24h.
  reviewedAt       DateTime? @map("reviewed_at")
  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([reviewedAt, createdAt])
  @@index([prescriptionId])
  @@map("prescription_overrides")
}

/// What the patient is told, in the language they read (S-06-08).
/// CMP-DPDP-02 requires the patient's own language, not the clinician's.
model PatientInstruction {
  id          String  @id @default(uuid()) @db.Uuid
  patientId   String  @map("patient_id") @db.Uuid
  encounterId String? @map("encounter_id") @db.Uuid

  title String

  /// The issued text — ENCRYPTED.
  body String

  /// The clinician's original wording, retained ALONGSIDE any rewritten
  /// version so the author's intent is never silently replaced. ENCRYPTED.
  clinicianWording String? @map("clinician_wording")

  /// BCP-47-ish short code: 'en', 'kn', 'hi', 'ta', 'ml'. `title` and `body`
  /// above are written IN this language — the patient's, not the clinician's.
  language String @default("en")

  /// ⚠️ A6 — patient-facing documents are bilingual, and S-06-08's drawing
  /// note is explicit: "draw BOTH languages on one printed artefact". These
  /// hold the English counterpart of `title` / `body` when `language` is not
  /// 'en'; they stay null when it is, because then `body` already IS English.
  ///
  /// Nullable on purpose. English-only is a legitimate fallback (the AI-110
  /// guardrail says so in those words) and a clinician must never be blocked
  /// from issuing instructions because a second language is missing. What the
  /// nullability buys is that the printed sheet can SAY the counterpart is
  /// absent instead of quietly printing half a bilingual document.
  titleEnglish String? @map("title_english")
  /// ENCRYPTED, same as `body`.
  bodyEnglish  String? @map("body_english")

  issuedAt       DateTime @default(now()) @map("issued_at")
  issuedByUserId String   @map("issued_by_user_id") @db.Uuid
  issuedByName   String   @map("issued_by_name")

  createdAt DateTime @default(now()) @map("created_at")

  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter Encounter?     @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  @@index([patientId, issuedAt])
  @@index([encounterId])
  @@map("patient_instructions")
}

/// Personal and facility-wide note / order-set templates (S-06-10, ARC-18).
///
/// Effective-dated: a template has a window. ⚠️ Promotion to facility-wide is
/// a GOVERNANCE ACT with a named owner and a review date, not a convenience —
/// an unowned facility-wide template is how bad practice gets institutionalised.
model ClinicalTemplate {
  id    String        @id @default(uuid()) @db.Uuid
  key   String        @unique
  name  String
  scope TemplateScope @default(Personal)

  /// Which surface it fills. A plain String rather than an enum so the set can
  /// widen without a migration — but it is NOT free text: the closed set lives
  /// in `src/template/template.routes.ts` (`CATEGORIES`) and is enforced by
  /// zod on every write. That file is the source of truth; this comment
  /// follows it.
  ///
  /// 'Consultation' | 'Subjective' | 'Objective' | 'Assessment' | 'Plan' |
  /// 'Instructions' | 'Procedure' | 'OrderSet'.
  category String

  body String

  ownerUserId String @map("owner_user_id") @db.Uuid
  ownerName   String @map("owner_name")

  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  /// Facility-wide templates carry a review date — the governance commitment.
  reviewDueAt DateTime? @map("review_due_at")

  promotionRequestedAt DateTime? @map("promotion_requested_at")
  promotedAt           DateTime? @map("promoted_at")
  promotedByUserId     String?   @map("promoted_by_user_id") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([scope, category])
  @@index([ownerUserId])
  @@map("clinical_templates")
}

/// Emergency access for a clinician who HOLDS the capability but has NO care
/// relationship.
///
/// ⚠️ UI_ATLAS §3.2 / DD-014: such an actor is not refused — they are OFFERED
/// break-glass. "An authorization model that can block resuscitation is the
/// wrong model." They state a reason, proceed, and the access is logged and
/// reviewed within 24 hours.
///
/// ⚠️ Grants EXPIRE. Expiry is the only thing stopping break-glass from
/// silently becoming a permanent care relationship.
model BreakGlassGrant {
  id        String @id @default(uuid()) @db.Uuid
  patientId String @map("patient_id") @db.Uuid

  actorUserId String @map("actor_user_id") @db.Uuid
  actorName   String @map("actor_name")

  reasonCategory BreakGlassReason @map("reason_category")

  /// Mandatory free text (≥10 chars) — ENCRYPTED. The category alone is not a
  /// reason anyone can review.
  reason String

  grantedAt DateTime @default(now()) @map("granted_at")
  expiresAt DateTime @map("expires_at")

  reviewedAt       DateTime?          @map("reviewed_at")
  reviewedByUserId String?            @map("reviewed_by_user_id") @db.Uuid
  outcome          BreakGlassOutcome?
  reviewNote       String?            @map("review_note")

  createdAt DateTime @default(now()) @map("created_at")

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([actorUserId, expiresAt])
  @@index([patientId, grantedAt])
  @@index([reviewedAt, grantedAt])
  @@map("break_glass_grants")
}
