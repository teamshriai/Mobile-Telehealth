# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://oncotrace_user:your_strong_password@localhost:5432/oncotrace_db?schema=public"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: no  de -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_CHARACTER_MINIMUM_CRYPTOGRAPHICALLY_RANDOM_STRING"
JWT_EXPIRES_IN="15m"

# Refresh token session lifetime in days. Access tokens stay short (15m);
# the refresh token is what keeps a patient signed in across that boundary.
REFRESH_TOKEN_TTL_DAYS=30

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ─── Client ───────────────────────────────────────────────────────────────────
# Used to build the password reset link. Point this at the deployed frontend origin.
CLIENT_URL="http://localhost:5173"

EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# ─── Argon2id ─────────────────────────────────────────────────────────────────
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ─── Rate Limiting ────────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100

# ─── Demo / presentation account ───────────────────────────────────────────────
# Required only when running `npm run db:seed` with SEED_DEMO not set to
# 'false'. Deliberately has NO hardcoded fallback in seed.ts — set your own
# value here, never reuse this file's placeholder in a shared environment.
DEMO_PATIENT_PASSWORD=

# ─── Phase 6 engineering test fixtures ─────────────────────────────────────────
# Required only when running prisma/scripts/seed-phase6-test-accounts.ts by
# hand (NOT part of the normal `db:seed` flow). Creates a HealthcareWorker
# and a Doctor test account for exercising the registration/encounter RBAC
# boundaries — not product-demonstration data. No hardcoded fallback, same
# convention as DEMO_PATIENT_PASSWORD above.
TEST_ACCOUNT_PASSWORD=
