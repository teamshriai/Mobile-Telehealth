# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://oncotrace_user:your_strong_password@localhost:5432/oncotrace_db?schema=public"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: no  de -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_CHARACTER_MINIMUM_CRYPTOGRAPHICALLY_RANDOM_STRING"
JWT_EXPIRES_IN="15m"

# Refresh token session lifetime in days. Access tokens stay short (15m);
# the refresh token is what keeps a patient signed in across that boundary.
REFRESH_TOKEN_TTL_DAYS=30

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ─── Client ───────────────────────────────────────────────────────────────────
# Used to build the password reset link. Point this at the deployed frontend origin.
# ⚠️ REQUIRED — the server will not boot without it. It is the origin used in
# links inside outbound email (password reset, notification buttons).
#
# It must be an address the RECIPIENT can reach. `localhost` in an email means
# the recipient's own device, so a clinician tapping a reset link on their
# phone gets connection-refused. When testing over LAN, set this to the machine's
# LAN address — e.g. CLIENT_URL="http://192.168.1.42:3000" — not localhost.
CLIENT_URL="http://localhost:3000"

EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# ─── Argon2id ─────────────────────────────────────────────────────────────────
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ─── Rate Limiting ────────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Login counts FAILED attempts only, so this is higher than AUTH_RATE_LIMIT_MAX
# without being weaker — a successful sign-in never consumes the allowance.
LOGIN_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1000

# ─── Demo / presentation account ───────────────────────────────────────────────
# Required only when running `npm run db:seed` with SEED_DEMO not set to
# 'false'. Deliberately has NO hardcoded fallback in seed.ts — set your own
# value here, never reuse this file's placeholder in a shared environment.
DEMO_PATIENT_PASSWORD=

# ─── Demo clinic (doctor portal) ───────────────────────────────────────────────
# Required only when running `npm run db:demo:clinic`, which builds the
# doctor-portal demonstration: the UI_ATLAS §8 cast, their diary, availability,
# feedback and clinical history. Shared by both demo consultants
# (demo.doctor.iyer@ and demo.doctor.desai@stroke-ai.invalid). These accounts
# ARE signed into during demonstrations, so — same rule as
# DEMO_PATIENT_PASSWORD — there is no hardcoded fallback and the script fails
# loudly when this is unset. Re-running the script resets the password to
# whatever this is currently set to.
DEMO_CLINIC_PASSWORD=

# ─── Phase 6 engineering test fixtures ─────────────────────────────────────────
# Required only when running prisma/scripts/seed-phase6-test-accounts.ts by
# hand (NOT part of the normal `db:seed` flow). Creates a HealthcareWorker
# and a Doctor test account for exercising the registration/encounter RBAC
# boundaries — not product-demonstration data. No hardcoded fallback, same
# convention as DEMO_PATIENT_PASSWORD above.
TEST_ACCOUNT_PASSWORD=

# ─── AI Insights (assistant) ───────────────────────────────────────────────────
# NOT required today. AI Insights currently ships as a finished UI plus a
# persistence layer with no model behind it — every assistant turn is stored as
# an explicit placeholder. Leave the key blank and the feature keeps working
# exactly as it does now; fill it in when you wire the model up.
#
# SECURITY — three rules for this value:
#   1. The real key lives ONLY in server/.env, which is gitignored. Never put
#      it in this file: .env.example IS committed.
#   2. Never give it a VITE_ prefix and never put it in client/.env. Vite
#      inlines every VITE_* variable into the browser bundle, so an AI key
#      placed there is published to every visitor. This key is server-side
#      only; the browser must always reach the model through this API.
#   3. If it is ever pasted into a commit, a screenshot or a chat, rotate it at
#      the provider rather than deleting the message — assume it is burned.
#
# Which provider you use decides which key line to fill. Set AI_PROVIDER to
# match, and leave the unused key blank.
AI_PROVIDER=anthropic

# Anthropic (console.anthropic.com) — keys look like "sk-ant-api03-…"
ANTHROPIC_API_KEY=

# OpenAI, if you use it instead — keys look like "sk-proj-…" or "sk-…"
OPENAI_API_KEY=

# Model id to call. Anthropic examples: claude-opus-5 (most capable),
# claude-sonnet-5 (balanced — a good default for patient-facing explanation),
# claude-haiku-4-5-20251001 (fastest/cheapest).
AI_MODEL="claude-sonnet-5"

# Hard ceiling on a single model call. A patient staring at a spinner needs the
# request to fail cleanly rather than hang.
AI_REQUEST_TIMEOUT_MS=12000
# Ceiling on the whole assistant turn (pacing wait + one retry). Must stay
# below the client's 45s send timeout.
AI_OVERALL_DEADLINE_MS=38000

# Reply length cap, and the one retry's cap when a reply comes back empty or
# cut off (a reasoning model spends part of the cap thinking).
AI_MAX_COMPLETION_TOKENS=1100
AI_RETRY_COMPLETION_TOKENS=1800

# How much of the patient's record the assistant is given per turn. The whole
# record goes in when it fits; otherwise the sections the question is about.
AI_CONTEXT_TOKENS=2400

# Quote the Assessment and Plan of SIGNED visit notes to the assistant (never
# the history or examination). Set false to withhold them.
AI_INCLUDE_NOTE_ASSESSMENT_PLAN=true

# Questions per patient per day, and the provider's limits (Groq free tier
# shown). The day resets at 00:00 UTC — 05:30 India time.
AI_PATIENT_DAILY_MESSAGES=15
AI_LIMIT_RPM=30
AI_LIMIT_RPD=1000
AI_LIMIT_TPM=8000
AI_LIMIT_TPD=200000


# ─────────────────────────────────────────────────────────────────────────────
# Mobile OTP authentication
#
# Sign-in is mobile number + a 6-digit one-time code. Password login remains on
# the API and is NOT advertised in the UI — it is still used by the G4
# second-consultant hard-stop override in prescription.service.ts, which
# authenticates a second clinician by email + password before an allergy
# override is permitted.
# ─────────────────────────────────────────────────────────────────────────────

# How long a code stays valid. Long enough to survive a slow SMS route and
# fetching your phone from another room; short enough that a code glimpsed on
# a lock screen is not still live an hour later.
OTP_TTL_SECONDS=300

# Failed guesses before the challenge is burned. 5 against a 6-digit space is
# a 1-in-200,000 chance per challenge.
OTP_MAX_ATTEMPTS=5

# Server-enforced resend cooldown. The countdown in the UI is presentation;
# this is the control that stops a held-down button becoming an SMS bill and a
# denial of service against whoever owns the handset.
OTP_RESEND_COOLDOWN_SECONDS=30

# ⚠️ DEVELOPMENT / DEMO ONLY — while no SMS provider is contracted.
# When set, every OTP the server issues is this code. It is still hashed,
# expired, attempt-capped and single-use; any other code fails. The server
# REFUSES TO BOOT with this set when NODE_ENV=production.
# To go live: configure SMS_* above and delete this line. No code change.
# ⚠️ While on, anyone who knows a PATIENT's mobile number can sign in as them
# (staff cannot use OTP). Do not leave it on for a LAN-exposed demo you do
# not control.
# OTP_DEV_FIXED_CODE=123456

# ── Voice health notes: local speech-to-text ─────────────────────────────────
# `local` runs Whisper (small, multilingual, 8-bit) INSIDE this server — a
# patient's recorded voice never leaves the machine. Fetch and pin the model
# once per environment:   npm run models:fetch:whisper   (~240 MB, gitignored)
# In production the server refuses to start with `local` unless the model on
# disk matches models/whisper-manifest.json. `off` (the default) offers typed
# notes only. Measured on an i7-1255U, CPU only: ~0.2x real time, ~1.4 GB RAM.
# STT_PROVIDER=local
# STT_MAX_SECONDS=120
# STT_QUEUE_MAX=4
# STT_TIMEOUT_MS=120000

# Encrypted patient files (voice-note audio). AES-256-GCM with a key derived
# from ENCRYPTION_KEY; created 0700. Keep OUTSIDE any web root and back it up
# with the database — a row without its file is an unplayable recording.
# FILE_STORAGE_DIR=./storage

# ── SMS delivery ─────────────────────────────────────────────────────────────
# ⚠️ REQUIRED IN PRODUCTION — the server refuses to boot without all three,
# because a production server that cannot send an SMS cannot log anybody in.
#
# In development, leave these unset. The OTP is then written to
# server/.otp-outbox.json (gitignored, never served over HTTP, refused
# outright when NODE_ENV=production) so the Playwright suite can read it.
# There is deliberately NO bypass code and no dev endpoint that returns the
# OTP — a debug route is the thing that survives a deploy.
# SMS_PROVIDER=msg91
# SMS_API_KEY=            # MSG91 auth key
# SMS_SENDER_ID=          # 3-11 chars, DLT-approved
# SMS_TEMPLATE_ID=        # ⚠️ DLT-registered template id. Indian carriers
#                         # reject transactional SMS without one, so without
#                         # this MSG91 accepts the call and nothing arrives.

# ── Email OTP ────────────────────────────────────────────────────────────────
# Uses the EMAIL_* SMTP settings above — there is nothing extra to configure.
#
# ⚠️ IN PRODUCTION, AT LEAST ONE CHANNEL MUST BE FULLY CONFIGURED (SMS_* or
# EMAIL_*). The server refuses to boot with neither, because every login would
# then return "a code has been sent" while nothing was ever sent — a silent
# failure indistinguishable from an unregistered account.
