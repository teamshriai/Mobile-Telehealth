# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://oncotrace_user:your_strong_password@localhost:5432/oncotrace_db?schema=public"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: no  de -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_CHARACTER_MINIMUM_CRYPTOGRAPHICALLY_RANDOM_STRING"
JWT_EXPIRES_IN="15m"

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ─── Client ───────────────────────────────────────────────────────────────────
# Used to build the password reset link. Point this at the deployed frontend origin.
CLIENT_URL="http://localhost:5173"

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Required in production (server refuses to start without these).
# Optional in development — when unset, the reset link is logged to the
# console instead of emailed, so local dev never needs real credentials.
#
# Example for an IONOS-hosted mailbox (e.g. no-reply@shri-ai.org):
#   EMAIL_HOST=smtp.ionos.com
#   EMAIL_PORT=587
#   EMAIL_SECURE=false      # false = STARTTLS on 587, true = implicit TLS on 465
#   EMAIL_USER=no-reply@shri-ai.org
#   EMAIL_PASSWORD=the mailbox password
#   EMAIL_FROM="OncoTrace AI <no-reply@shri-ai.org>"
#
# Example for a Gmail mailbox (e.g. teamshriai@gmail.com):
#   Gmail rejects the account's normal password for SMTP — you need an
#   App Password instead: myaccount.google.com/apppasswords (requires
#   2-Step Verification to be turned on first: myaccount.google.com/signinoptions/two-step-verification)
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_SECURE=false
#   EMAIL_USER=teamshriai@gmail.com
#   EMAIL_PASSWORD=the 16-character App Password (not your Gmail login password)
#   EMAIL_FROM="OncoTrace AI <teamshriai@gmail.com>"
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# ─── Field-level encryption (PatientProfile PII) ──────────────────────────────
# Required in every environment (not just production) — encrypted data must
# round-trip in dev too. Each must be 32 random bytes, base64-encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a DIFFERENT value for each — never reuse one key for both.
ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# ─── Argon2id ─────────────────────────────────────────────────────────────────
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ─── Rate Limiting ────────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100
